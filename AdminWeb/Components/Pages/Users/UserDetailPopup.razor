    /// <summary>
    /// 수정 모드를 활성화합니다.
    /// 관리자만 호출할 수 있고, 버튼도 관리자에게만 표시됩니다.
    /// </summary>
    private void EnableEdit()
    {
        if (!_isAdmin)
        {
            return;
        }

        _editMode = true;
        _message = null;
    }

    /// <summary>
    /// 수정 모드를 취소하고 상세 조회 당시 값으로 되돌립니다.
    /// </summary>
    private void CancelEdit()
    {
        _editMode = false;
        _processMemo = null;
        BindDetailToForm();
    }

    /// <summary>
    /// 담당자 기본정보와 상태 변경을 저장합니다.
    ///
    /// 처리 순서:
    /// 1. 담당자 기본정보 수정 API 호출
    /// 2. 상태 값이 변경된 경우 상태 변경 API 호출
    /// 3. 상세 정보와 로그를 다시 조회
    ///
    /// 상태 변경은 즉시 처리하지 않고, 수정 모드에서 저장 버튼을 눌렀을 때만 처리됩니다.
    /// </summary>
    private async Task SaveUserAsync()
    {
        _message = null;

        if (!_isAdmin)
        {
            SetWarning("담당자 정보 수정 권한이 없습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.UserName))
        {
            SetWarning("담당자명을 입력하세요.");
            return;
        }

        _isSaving = true;

        try
        {
            _form.UserCode = UserCode;

            var updateResult = await ApiClient.PutAsync<UserUpdateRequest, ApiResponse<UserSaveResponse>>(
                $"/api/manage/users/{UserCode}",
                _form);

            if (updateResult == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!updateResult.Success)
            {
                SetWarning(updateResult.Message);
                return;
            }

            var statusChanged = _selectedStatus != _detail.UserStatus;

            if (statusChanged)
            {
                var statusSaved = await SaveStatusChangeAsync();

                if (!statusSaved)
                {
                    return;
                }
            }

            // 정보수정 요청 처리 흐름에서 저장한 경우,
            // 실제 정보 수정이 완료된 뒤 요청 상태도 처리 완료로 변경한다.
            if (_completeRequestAfterUserSave && HasPendingRequest)
            {
                var completed = await CompleteCurrentRequestAsync(
                    UserRequestMetadata.GetDefaultProcessMemo(_detail.UserRequestType));

                if (!completed)
                {
                    return;
                }

                _completeRequestAfterUserSave = false;
            }
            SetSuccess(statusChanged
                ? "담당자 정보와 상태가 저장되었습니다."
                : "담당자 정보가 저장되었습니다.");

            _editMode = false;
            _processMemo = null;

            await LoadDetailAsync();
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// 담당자 상태 변경을 저장합니다.
    ///
    /// 승인대기 상태에서 정상으로 변경하는 경우에는 기존 승인 API를 사용합니다.
    /// 그 외 상태 변경은 기존 상태 변경 API를 사용합니다.
    /// </summary>
    private async Task<bool> SaveStatusChangeAsync()
    {
        if (_detail.UserStatus == 0 && _selectedStatus == 1)
        {
            var approveRequest = new UserRequestProcessRequest
            {
                Memo = _processMemo
            };

            var approveResult = await ApiClient.PostAsync<UserRequestProcessRequest, ApiResponse<bool>>(
                $"/api/manage/users/{UserCode}/approve",
                approveRequest);

            if (approveResult == null)
            {
                SetWarning("상태 변경 응답을 받을 수 없습니다.");
                return false;
            }

            if (!approveResult.Success)
            {
                SetWarning(approveResult.Message);
                return false;
            }

            return true;
        }

        var request = new UserStatusChangeRequest
        {
            NewStatus = _selectedStatus,
            Memo = _processMemo
        };

        var result = await ApiClient.PostAsync<UserStatusChangeRequest, ApiResponse<bool>>(
            $"/api/manage/users/{UserCode}/status",
            request);

        if (result == null)
        {
            SetWarning("상태 변경 응답을 받을 수 없습니다.");
            return false;
        }

        if (!result.Success)
        {
            SetWarning(result.Message);
            return false;
        }

        return true;
    }

    /// <summary>
    /// 담당자 계정이 관리자에게 변경 요청을 등록합니다.
    ///
    /// 관리자 계정은 직접 수정 권한이 있으므로 이 기능을 사용하지 않습니다.
    /// 담당자 계정은 직접 정보를 수정하지 않고 요청 유형과 사유를 등록합니다.
    /// 요청 등록 후 상세정보와 로그를 다시 조회해서 최근 요청 상태를 갱신합니다.
    /// </summary>
    private async Task CreateRequestAsync()
    {
        _message = null;

        if (_isAdmin)
        {
            SetWarning("관리자는 변경 요청이 아니라 직접 수정 기능을 사용하세요.");
            return;
        }

        if (UserCode <= 0)
        {
            SetWarning("담당자 코드가 올바르지 않습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_requestReason))
        {
            SetWarning("요청 사유를 입력하세요.");
            return;
        }

        _isSaving = true;

        try
        {
            var request = new UserRequestCreateRequest
            {
                UserCode = UserCode,
                RequestType = _requestType,
                RequestReason = _requestReason
            };

            var result = await ApiClient.PostAsync<UserRequestCreateRequest, ApiResponse<bool>>(
                $"/api/manage/users/{UserCode}/requests",
                request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("변경 요청이 등록되었습니다.");

            _requestReason = null;
            _requestType = 2;

            await LoadDetailAsync();
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"요청 등록 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// 비밀번호 변경 입력 영역을 열거나 닫습니다.
    ///
    /// 닫을 때는 입력한 비밀번호 값을 모두 초기화합니다.
    /// 비밀번호 값이 화면 상태에 남아 있지 않도록 하기 위한 처리입니다.
    /// </summary>
    private void TogglePasswordChange()
    {
        _showPasswordChange = !_showPasswordChange;

        if (!_showPasswordChange)
        {
            ClearPasswordFields();
        }
    }

    /// <summary>
    /// 현재 로그인 사용자가 본인 계정의 비밀번호를 변경합니다.
    ///
    /// 조건:
    /// - 현재 팝업의 UserCode가 로그인한 UserCode와 같아야 합니다.
    /// - 현재 비밀번호를 입력해야 합니다.
    /// - 새 비밀번호와 새 비밀번호 확인 값이 일치해야 합니다.
    ///
    /// 백엔드 API는 본인 비밀번호 변경 전용 API를 사용하는 것을 전제로 합니다.
    /// 현재 프로젝트의 실제 API 주소가 다르면 url 값만 맞춰서 변경하면 됩니다.
    /// </summary>
    private async Task ChangeMyPasswordAsync()
    {
        _message = null;

        if (!IsMyAccount)
        {
            SetWarning("본인 계정의 비밀번호만 변경할 수 있습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            SetWarning("현재 비밀번호를 입력하세요.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            SetWarning("새 비밀번호를 입력하세요.");
            return;
        }

        if (_newPassword != _newPasswordConfirm)
        {
            SetWarning("새 비밀번호와 비밀번호 확인이 일치하지 않습니다.");
            return;
        }

        _isSaving = true;

        try
        {
            var request = new MyPasswordChangeRequest
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword
            };

            var result = await ApiClient.PostAsync<MyPasswordChangeRequest, ApiResponse<bool>>(
                $"/api/manage/users/{UserCode}/password-change",
                request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("비밀번호가 변경되었습니다.");

            _showPasswordChange = false;
            ClearPasswordFields();
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"비밀번호 변경 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// 관리자에 의한 담당자 비밀번호 초기화 모달을 엽니다.
    ///
    /// 화면에서는 System/Admin 계정만 접근할 수 있도록 제한하고,
    /// 실제 세부 권한은 백엔드 API에서 최종 검증합니다.
    /// </summary>
    private void OpenPasswordResetModal()
    {
        if (!_isAdmin)
        {
            SetWarning("담당자 비밀번호 초기화 권한이 없습니다.");
            return;
        }

        if (UserCode <= 0)
        {
            SetWarning("비밀번호를 초기화할 담당자 코드가 올바르지 않습니다.");
            return;
        }

        _showPasswordResetModal = true;
    }
    /// <summary>
    /// 현재 담당자의 처리 대기 요청을 처리완료 상태로 변경한다.
    ///
    /// 실제 작업이 완료된 뒤 호출해야 한다.
    /// 예:
    /// - 정보수정 저장 완료 후
    /// - 비밀번호 초기화 완료 후
    ///
    /// 상태 변경 요청은 /status API에서 이미 완료 처리하므로 이 메서드를 호출하지 않는다.
    /// </summary>
    private async Task<bool> CompleteCurrentRequestAsync(string defaultMemo)
    {
        var request = new UserRequestProcessRequest
        {
            Memo = string.IsNullOrWhiteSpace(_requestProcessMemo)
                ? defaultMemo
                : _requestProcessMemo
        };

        var result = await ApiClient.PostAsync<UserRequestProcessRequest, ApiResponse<bool>>(
            $"/api/manage/users/{UserCode}/requests/process",
            request);

        if (result == null)
        {
            SetWarning("요청 처리 응답을 받을 수 없습니다.");
            return false;
        }

        if (!result.Success)
        {
            SetWarning(result.Message);
            return false;
        }

        _requestProcessMemo = null;

        return true;
    }
    /// <summary>
    /// 비밀번호 초기화 모달을 닫습니다.
    /// </summary>
    private void ClosePasswordResetModal()
    {
        _showPasswordResetModal = false;
    }

    /// <summary>
    /// 비밀번호 초기화 완료 후 호출된다.
    ///
    /// 일반 비밀번호 초기화인 경우에는 상세정보와 로그만 다시 조회한다.
    /// 비밀번호 초기화 요청 처리 흐름에서 실행된 경우에는 요청 처리 완료 API까지 호출한다.
    /// </summary>
    private async Task OnPasswordResetCompleted()
    {
        if (_completeRequestAfterPasswordReset)
        {
            var completed = await CompleteCurrentRequestAsync(
                UserRequestMetadata.GetDefaultProcessMemo(_detail.UserRequestType));

            if (!completed)
            {
                return;
            }

            _completeRequestAfterPasswordReset = false;
            _showPasswordResetModal = false;

            SetSuccess("비밀번호 초기화 요청이 처리되었습니다.");

            await LoadDetailAsync();
            await LoadLogsAsync();

            return;
        }

        SetSuccess("담당자 비밀번호가 초기화되었습니다.");

        await LoadDetailAsync();
        await LoadLogsAsync();
    }

    /// <summary>
    /// 담당자 요청처리 모달을 연다.
    ///
    /// 처리 대기 중인 요청이 없으면 모달을 열지 않는다.
    /// 다음 단계에서 실제 UserRequestProcessModal 컴포넌트와 연결한다.
    /// </summary>
    private void OpenRequestProcessModal()
    {
        if (!CanViewUserRequests)
        {
            SetWarning("담당자 요청내역을 처리할 권한이 없습니다.");
            return;
        }

        if (!HasPendingRequest)
        {
            SetWarning("처리 대기 중인 요청이 없습니다.");
            return;
        }

        _showRequestProcessModal = true;
    }

    /// <summary>
    /// 담당자 요청처리 모달을 닫는다.
    /// </summary>
    private void CloseRequestProcessModal()
    {
        _showRequestProcessModal = false;
    }

    /// <summary>
    /// 요청 처리 또는 반려 완료 후 상세정보와 로그를 다시 조회한다.
    ///
    /// LoadDetailAsync 내부에서 메시지를 초기화하므로,
    /// 성공 메시지는 데이터 재조회가 끝난 뒤 설정한다.
    /// </summary>
    private async Task OnRequestProcessCompleted()
    {
        _showRequestProcessModal = false;
        _completeRequestAfterUserSave = false;
        _completeRequestAfterPasswordReset = false;
        _requestProcessMemo = null;

        await LoadDetailAsync();
        await LoadLogsAsync();

        SetSuccess("담당자 요청이 처리되었습니다.");

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 정보수정 요청 처리 흐름을 시작한다.
    ///
    /// 요청처리 모달에서 전달받은 처리 메모를 보관하고,
    /// 담당자 상세 화면을 수정 모드로 전환한다.
    /// 이후 저장 버튼을 누르면 SaveUserAsync에서 요청 처리 완료 API를 호출한다.
    /// </summary>
    private void OpenEditModeFromRequest(string? processMemo)
    {
        if (!HasPendingRequest)
        {
            SetWarning("처리 대기 중인 요청이 없습니다.");
            return;
        }

        _showRequestProcessModal = false;
        _completeRequestAfterUserSave = true;
        _requestProcessMemo = processMemo;
        _editMode = true;

        SetWarning("요청 내용을 확인한 뒤 담당자 정보를 수정하고 저장하세요.");
    }

    /// <summary>
    /// 비밀번호 초기화 요청 처리 흐름을 시작한다.
    ///
    /// 요청처리 모달에서 전달받은 처리 메모를 보관하고,
    /// 공통 비밀번호 초기화 모달을 연다.
    /// 비밀번호 초기화가 성공하면 OnPasswordResetCompleted에서 요청 처리 완료 API를 호출한다.
    /// </summary>
    private void OpenPasswordResetFromRequest(string? processMemo)
    {
        if (!HasPendingRequest)
        {
            SetWarning("처리 대기 중인 요청이 없습니다.");
            return;
        }

        _showRequestProcessModal = false;
        _completeRequestAfterPasswordReset = true;
        _requestProcessMemo = processMemo;

        OpenPasswordResetModal();
    }

    /// <summary>
    /// 비밀번호 변경 입력값을 초기화합니다.
    /// </summary>
    private void ClearPasswordFields()
    {
        _currentPassword = null;
        _newPassword = null;
        _newPasswordConfirm = null;
    }

    /// <summary>
    /// 본인 비밀번호 변경 요청 DTO.
    ///
    /// 이 DTO는 팝업 내부에서만 사용하는 로컬 요청 모델.
    /// </summary>
    private sealed class MyPasswordChangeRequest
    {
        public string? CurrentPassword { get; set; }

        public string? NewPassword { get; set; }
    }

    private string GetPartnerName(int? partnerCode)
    {
        if (partnerCode == null || partnerCode <= 0)
        {
            return "파트너사 미지정";
        }

        var partner = _partners.FirstOrDefault(x => x.PartnerCode == partnerCode.Value);

        if (partner == null)
        {
            return $"파트너코드 {partnerCode.Value}";
        }

        return partner.PartnerName;
    }

    private string GetUserStatusName(int status)
    {
        return status switch
        {
            0 => "승인대기",
            1 => "정상",
            2 => "일시중지",
            3 => "무효",
            9 => "차단",
            _ => $"기타({status})"
        };
    }

    private string GetUserStatusBadge(int status)
    {
        return status switch
        {
            0 => "badge bg-warning text-dark",
            1 => "badge bg-success",
            2 => "badge bg-secondary",
            3 => "badge bg-dark",
            9 => "badge bg-danger",
            _ => "badge bg-light text-dark"
        };
    }

    private string GetRequestTypeName(int? requestType)
    {
        return UserRequestMetadata.GetRequestTypeName(requestType);
    }

    private string GetRequestStatusName(int requestStatus)
    {
        return UserRequestMetadata.GetRequestStatusName(requestStatus);
    }

    private string GetLogTypeName(int logType)
    {
        return logType switch
        {
            1 => "등록",
            2 => "승인요청",
            3 => "승인처리",
            4 => "승인반려",
            5 => "정보수정요청",
            6 => "정보수정처리",
            7 => "비밀번호변경",
            8 => "비밀번호초기화",
            9 => "일시중지요청",
            10 => "일시중지처리",
            11 => "정상복구요청",
            12 => "정상복구처리",
            13 => "무효요청",
            14 => "무효처리",
            15 => "차단요청",
            16 => "차단처리",
            _ => $"기타({logType})"
        };
    }

    private async Task ClosePopupAsync()
    {
        await JS.InvokeVoidAsync("window.close");
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }
}

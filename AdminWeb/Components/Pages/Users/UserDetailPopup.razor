@page "/users/popup/{UserCode:int}"
@layout poscam.AdminWeb.Components.Layout.PopupLayout
@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@using poscam.AdminWeb.Models.UserManage
@using poscam.AdminWeb.Components.Pages.Common

@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>담당자 상세</PageTitle>

<div class="user-popup">
    <div class="popup-header">
        <div>
            <h5 class="mb-0">담당자 상세</h5>
            <small class="text-muted">
                UserCode: @UserCode
            </small>
        </div>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="ClosePopupAsync">
            닫기
        </button>
    </div>

    <div class="popup-body">
        <ul class="nav nav-tabs popup-tab-header">
            <li class="nav-item">
                <button type="button"
                        class="@(GetTabClass("basic"))"
                        @onclick="@(() => ChangeTabAsync("basic"))">
                    담당자 정보
                </button>
            </li>

            <li class="nav-item">
                <button type="button"
                        class="@(GetTabClass("logs"))"
                        @onclick="@(() => ChangeTabAsync("logs"))">
                    변경 로그
                </button>
            </li>
        </ul>

        @if (_activeTab == "basic")
        {
            <div class="tab-area">
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @MessageCss">
                        @_message
                    </div>
                }

                @if (_isLoading)
                {
                    <div class="alert alert-info">
                        담당자 정보를 불러오는 중입니다.
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>담당자 기본정보</strong>

                            <span class="@GetUserStatusBadge(_detail.UserStatus)">
                                @GetUserStatusName(_detail.UserStatus)
                            </span>
                        </div>

                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">아이디</label>
                                    <input class="form-control"
                                           value="@_detail.UserId"
                                           readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">파트너사</label>

                                    @if (_isAdmin)
                                    {
                                        <select class="form-select"
                                                @bind="_form.PartnerCode"
                                                disabled="@(!CanEditForm)">
                                            <option value="">파트너사를 선택하세요</option>
                                            @foreach (var partner in _partners)
                                            {
                                                <option value="@partner.PartnerCode">
                                                    @partner.PartnerName
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control"
                                               value="@GetPartnerName(_form.PartnerCode)"
                                               readonly />
                                    }
                                </div>

                                
                            </div>

                            <div class="row mb-3">
                                
                                <div class="col-md-3">
                                    <label class="form-label">
                                        담당자명 <span class="text-danger">*</span>
                                    </label>
                                    <input class="form-control"
                                           @bind="_form.UserName"
                                           readonly="@(!CanEditForm)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">연락처</label>
                                    <input class="form-control"
                                           @bind="_form.UserCell"
                                           readonly="@(!CanEditForm)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">이메일</label>
                                    <input class="form-control"
                                           @bind="_form.UserEmail"
                                           readonly="@(!CanEditForm)" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                
                                <div class="col-md-4">
                                    <label class="form-label">등록일</label>
                                    <input class="form-control"
                                           value="@_detail.UserRdate.ToString("yyyy-MM-dd HH:mm")"
                                           readonly />
                                </div>
                            </div>

               
                            @if (_isAdmin)
                            {
                                <hr />
                                <div class="row align-items-end g-3">
                                    <div class="col-md-2">
                                        <label class="form-label">상태 변경</label>

                                        <select class="form-select"
                                                @bind="_selectedStatus"
                                                disabled="@(!CanEditForm)">
                                            <option value="0">승인대기</option>
                                            <option value="1">정상</option>
                                            <option value="2">일시중지</option>
                                            <option value="3">무효</option>
                                            <option value="9">차단</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">상태 변경 / 처리 메모</label>
                                        <input class="form-control"
                                               @bind="_processMemo"
                                               readonly="@(!CanEditForm)"
                                               placeholder="상태 변경 사유 또는 처리 메모" />
                                    </div>

                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-end gap-2">
                                            @if (!_editMode)
                                            {
                                                <button class="btn btn-outline-primary"
                                                        @onclick="EnableEdit">
                                                    수정
                                                </button>

                                                <button class="btn btn-outline-danger"
                                                        @onclick="OpenPasswordResetModal"
                                                        disabled="@_isSaving">
                                                    비밀번호 초기화
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="CancelEdit"
                                                        disabled="@_isSaving">
                                                    취소
                                                </button>

                                                <button class="btn btn-primary"
                                                        @onclick="SaveUserAsync"
                                                        disabled="@_isSaving">
                                                    @(_isSaving ? "저장 중..." : "저장")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <hr />

                                <div class="card bg-light border-0 mb-3">
                                    <div class="card-body">
                                        <h6 class="mb-3">관리자 변경 요청</h6>

                                        <div class="row mb-3 g-3">
                                            <div class="col-md-4">
                                                <label class="form-label">요청 유형</label>
                                                <select class="form-select"
                                                        @bind="_requestType"
                                                        disabled="@_isSaving">
                                                    <option value="2">정보수정</option>
                                                    <option value="3">비밀번호초기화</option>
                                                    <option value="4">일시중지</option>
                                                    <option value="5">정상복구</option>
                                                    <option value="6">무효</option>
                                                    <option value="9">차단</option>
                                                </select>
                                            </div>

                                            <div class="col-md-8">
                                                <label class="form-label">요청 사유</label>
                                                <textarea class="form-control"
                                                          rows="3"
                                                          @bind="_requestReason"
                                                          disabled="@_isSaving"
                                                          placeholder="관리자에게 요청할 내용을 입력하세요."></textarea>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-end">
                                            <button class="btn btn-primary"
                                                    @onclick="CreateRequestAsync"
                                                    disabled="@_isSaving">
                                                @(_isSaving ? "요청 중..." : "변경 요청 등록")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (IsMyAccount)
                            {
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0">내 비밀번호 변경</h6>

                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="TogglePasswordChange"
                                                    disabled="@_isSaving">
                                                @(_showPasswordChange ? "닫기" : "비밀번호 변경")
                                            </button>
                                        </div>

                                        @if (_showPasswordChange)
                                        {
                                            <div class="row mb-3 g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">현재 비밀번호</label>
                                                    <input class="form-control"
                                                           type="password"
                                                           @bind="_currentPassword"
                                                           disabled="@_isSaving" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label">새 비밀번호</label>
                                                    <input class="form-control"
                                                           type="password"
                                                           @bind="_newPassword"
                                                           disabled="@_isSaving" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label">새 비밀번호 확인</label>
                                                    <input class="form-control"
                                                           type="password"
                                                           @bind="_newPasswordConfirm"
                                                           disabled="@_isSaving" />
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-end">
                                                <button class="btn btn-primary"
                                                        @onclick="ChangeMyPasswordAsync"
                                                        disabled="@_isSaving">
                                                    @(_isSaving ? "변경 중..." : "비밀번호 저장")
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (CanViewUserRequests)
                    {
                        <div class="card shadow-sm mt-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>요청내역</strong>

                                @if (HasPendingRequest)
                                {
                                    <span class="badge bg-warning text-dark">
                                        처리 대기
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        처리 요청 없음
                                    </span>
                                }
                            </div>

                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">최근 요청 유형</label>
                                        <input class="form-control"
                                               value="@GetRequestTypeName(_detail.UserRequestType)"
                                               readonly />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">요청일</label>
                                        <input class="form-control"
                                               value="@(_detail.UserRequestedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")"
                                               readonly />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">최근 요청 상태</label>
                                        <input class="form-control"
                                               value="@GetRequestStatusName(_detail.UserRequestStatus)"
                                               readonly />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">승인일</label>
                                        <input class="form-control"
                                               value="@(_detail.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")"
                                               readonly />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">최근 요청 사유</label>
                                        <textarea class="form-control"
                                      rows="1"
                                      readonly>@_detail.UserRequestReason</textarea>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">처리 결과 메모</label>
                                        <textarea class="form-control"
                                      rows="1"
                                      readonly>@_detail.UserRequestResultMemo</textarea>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button class="btn btn-primary"
                                            @onclick="OpenRequestProcessModal"
                                            disabled="@(!CanProcessUserRequest || _isSaving)">
                                        요청처리
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (_activeTab == "logs")
        {
            <div class="tab-area">
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @MessageCss">
                        @_message
                    </div>
                }

                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>변경 로그</strong>

                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="LoadLogsAsync"
                                disabled="@_isLogLoading">
                            @(_isLogLoading ? "조회 중..." : "새로고침")
                        </button>
                    </div>

                    <div class="card-body">
                        @if (_isLogLoading)
                        {
                            <div class="alert alert-info mb-0">
                                변경 로그를 불러오는 중입니다.
                            </div>
                        }
                        else if (_logs.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">
                                등록된 로그가 없습니다.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive"
                                 style="max-height: 540px; overflow-y: auto;">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>일시</th>
                                            <th>로그</th>
                                            <th>요청</th>
                                            <th>상태</th>
                                            <th>사유/메모</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var log in _logs)
                                        {
                                            <tr>
                                                <td>@log.UlogRdate.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@GetLogTypeName(log.UlogType)</td>
                                                <td>@GetRequestTypeName(log.UlogRequestType)</td>
                                                <td>@GetRequestStatusName(log.UlogRequestStatus ?? 0)</td>
                                                <td>
                                                    <div>@(log.UlogReason ?? "-")</div>
                                                    <small class="text-muted">@(log.UlogMemo ?? "")</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<PasswordResetModal IsOpen="_showPasswordResetModal"
                    TargetType="user"
                    UserCode="@UserCode"
                    TargetName="@_detail.UserName"
                    OnClose="ClosePasswordResetModal"
                    OnCompleted="OnPasswordResetCompleted" />

<UserRequestProcessModal IsOpen="_showRequestProcessModal"
                            UserCode="@UserCode"
                            UserName="@_detail.UserName"
                            RequestType="@_detail.UserRequestType"
                            RequestStatus="@_detail.UserRequestStatus"
                            RequestReason="@_detail.UserRequestReason"
                            RequestedAt="@_detail.UserRequestedAt"
                            OnClose="CloseRequestProcessModal"
                            OnCompleted="OnRequestProcessCompleted"
                            OnEditUserInfoRequested="OpenEditModeFromRequest"
                            OnPasswordResetRequested="OpenPasswordResetFromRequest" />

<style>
    .user-popup {
        width: 860px;
        height: 720px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .popup-header {
        height: 64px;
        padding: 12px 18px;
        border-bottom: 1px solid #dee2e6;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .popup-body {
        height: calc(720px - 64px);
        padding: 14px 18px;
        overflow: hidden;
    }

    .popup-tab-header {
        height: 42px;
        margin-bottom: 12px;
    }

    .tab-area {
        height: calc(720px - 64px - 14px - 14px - 42px - 12px);
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 6px;
    }
</style>

@code {
    [Parameter]
    public int UserCode { get; set; }

    private string _activeTab = "basic";

    private bool _isLoading = true;
    private bool _isLogLoading;
    private bool _isSaving;
    private bool _isAdmin;
    private bool _editMode;
    private bool _isSuccessMessage;

    private int _selectedStatus;
    private int? _loginUserCode;

    private int _requestType = 2;

    private string? _message;
    private string? _processMemo;
    private string? _requestReason;

    // 현재는 System/Admin이면 관리자 기능 사용 가능.
    // 이후 세부 권한을 프론트에서 받게 되면 이 속성들만 수정하면 됩니다.
    private bool CanManageUser => _isAdmin;
    private bool CanResetUserPassword => _isAdmin;
    /// <summary>
    /// 담당자 요청내역을 볼 수 있는지 여부.
    ///
    /// 현재 정책:
    /// - System 계정
    /// - Admin 계정
    ///
    /// 담당자 본인은 본인이 등록한 요청이라도 관리자 처리 영역을 볼 필요가 없으므로 제외한다.
    /// 이후 프론트에서 세부 권한을 받게 되면 이 속성만 수정하면 된다.
    /// </summary>
    private bool CanViewUserRequests => _isAdmin;

    /// <summary>
    /// 현재 담당자에게 처리 대기 중인 요청이 있는지 여부.
    ///
    /// 요청 유형/상태 판단은 UserRequestMetadata에서 공통 처리한다.
    /// </summary>
    private bool HasPendingRequest =>
        UserRequestMetadata.IsPendingRequest(
            _detail.UserRequestType,
            _detail.UserRequestStatus);

    /// <summary>
    /// 담당자 요청을 처리할 수 있는지 여부.
    ///
    /// 요청 처리 버튼의 활성화 여부에 사용한다.
    /// 실제 권한 검증은 백엔드 API에서 최종 처리한다.
    /// </summary>
    private bool CanProcessUserRequest =>
        CanViewUserRequests && HasPendingRequest;

    /// <summary>
    /// 요청처리 모달 표시 여부.
    ///
    /// 다음 단계에서 UserRequestProcessModal 컴포넌트와 연결한다.
    /// </summary>
    private bool _showRequestProcessModal;

    private bool _completeRequestAfterSave;

    /// <summary>
    /// 요청처리 모달에서 입력한 처리 메모.
    ///
    /// 정보수정 요청 또는 비밀번호 초기화 요청은 실제 처리가 부모 화면에서 이루어지므로,
    /// 요청처리 모달에서 입력한 메모를 임시 보관했다가 /requests/process 호출 시 사용한다.
    /// </summary>
    private string? _requestProcessMemo;

    // 본인 계정일 때만 사용하는 비밀번호 변경 입력 상태입니다.
    // 버튼을 누르기 전에는 입력 영역을 숨기고, 버튼 클릭 후에만 표시합니다.
    private bool _showPasswordChange;
    private string? _currentPassword;
    private string? _newPassword;
    private string? _newPasswordConfirm;
    private bool _showPasswordResetModal;
    /// <summary>
    /// 정보수정 요청 처리 흐름에서 수정 모드가 열린 상태인지 여부.
    ///
    /// true인 경우 담당자 정보를 저장한 뒤 요청 처리 완료 API를 호출한다.
    /// </summary>
    private bool _completeRequestAfterUserSave;

    /// <summary>
    /// 비밀번호 초기화 요청 처리 흐름에서 비밀번호 초기화 모달이 열린 상태인지 여부.
    ///
    /// true인 경우 비밀번호 초기화 완료 후 요청 처리 완료 API를 호출한다.
    /// </summary>
    private bool _completeRequestAfterPasswordReset;

    private string MessageCss => _isSuccessMessage
        ? "alert-success"
        : "alert-warning";

    // 담당자 팝업은 신규 등록이 아니라 기존 담당자 상세 전용입니다.
    // 따라서 수정 가능 여부는 관리자 + 수정 모드일 때만 true입니다.
    private bool CanEditForm => _isAdmin && _editMode;

    // 현재 로그인 사용자의 계정과 팝업에서 보고 있는 담당자 계정이 같은지 확인합니다.
    // 본인 계정일 때만 비밀번호 변경 기능을 노출합니다.
    private bool IsMyAccount => _loginUserCode != null && _loginUserCode.Value == UserCode;

    private UserManageDetailDto _detail = new();
    private UserUpdateRequest _form = new();
    private List<PartnerListItemDto> _partners = new();
    private List<UserLogItemDto> _logs = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 현재 로그인 계정의 권한을 확인합니다.
        // System 또는 관리자 계정만 수정 버튼과 저장 기능을 사용할 수 있습니다.
        var role = await AuthStateService.GetUserRoleAsync();
        // System = 0, Admin = 1
        _isAdmin = role == 0 || role == 1;

        // 비밀번호 변경 버튼은 본인 계정에서만 보여야 하므로,
        // 현재 로그인한 사용자의 UserCode를 함께 조회합니다.
        _loginUserCode = await AuthStateService.GetUserCodeAsync();

        await LoadPartnersAsync();
        await LoadDetailAsync();

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 탭을 변경합니다.
    /// 변경 로그 탭은 처음 열 때 목록을 조회합니다.
    /// </summary>
    private async Task ChangeTabAsync(string tab)
    {
        _activeTab = tab;

        if (tab == "logs" && _logs.Count == 0)
        {
            await LoadLogsAsync();
        }
    }

    /// <summary>
    /// 탭 버튼에 적용할 Bootstrap 클래스를 반환합니다.
    /// </summary>
    private string GetTabClass(string tab)
    {
        return _activeTab == tab
            ? "nav-link active"
            : "nav-link";
    }


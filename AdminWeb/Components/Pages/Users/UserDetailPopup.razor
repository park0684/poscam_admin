    /// <summary>
    /// 담당자 상세정보를 조회합니다.
    /// 조회된 데이터는 원본 DTO와 수정용 DTO에 각각 보관합니다.
    /// </summary>
    private async Task LoadDetailAsync()
    {
        _message = null;

        if (UserCode <= 0)
        {
            SetWarning("담당자 코드가 올바르지 않습니다.");
            return;
        }

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<UserManageDetailDto>>(
                $"/api/manage/users/{UserCode}");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            _detail = result.Data;
            BindDetailToForm();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 상세 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    /// <summary>
    /// 상세 조회 결과를 수정용 폼 DTO에 복사합니다.
    /// 상태 변경 드롭다운도 현재 상태로 초기화합니다.
    /// </summary>
    private void BindDetailToForm()
    {
        _form = new UserUpdateRequest
        {
            UserCode = _detail.UserCode,
            PartnerCode = _detail.PartnerCode,
            UserName = _detail.UserName,
            UserCell = _detail.UserCell,
            UserEmail = _detail.UserEmail
        };

        _selectedStatus = _detail.UserStatus;
    }


@using poscam.AdminWeb.Components.Pages.Common
@using poscam.AdminWeb.Models.Account
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.UserManage
@using poscam.AdminWeb.Services

@inject ApiClient ApiClient
@inject CurrentUserAccessService CurrentUserAccessService
@inject NavigationManager NavigationManager

@if (_canResetPassword)
{
    <div class="partner-user-password-reset-action">
        <button class="btn btn-sm btn-outline-danger"
                @onclick="OpenModal">
            비밀번호 초기화
        </button>
    </div>
}

<PasswordResetModal IsOpen="_showModal"
                    TargetType="user"
                    UserCode="@_targetUserCode"
                    TargetName="@_targetUserName"
                    OnClose="CloseModal"
                    OnCompleted="OnCompleted" />

<style>
    .partner-user-password-reset-action {
        position: fixed;
        top: 14px;
        right: 86px;
        z-index: 1040;
    }
</style>

@code {
    private int _targetUserCode;
    private string? _targetUserName;
    private bool _canResetPassword;
    private bool _showModal;

    protected override async Task OnInitializedAsync()
    {
        if (!TryResolveTargetUserCode(out var targetUserCode))
        {
            return;
        }

        var accessResult = await CurrentUserAccessService.GetCurrentAccessAsync();

        if (!accessResult.Success || accessResult.Data == null)
        {
            return;
        }

        var access = accessResult.Data;

        if (access.UserRole != CurrentUserAccessPolicy.PartnerUserRole ||
            !CurrentUserAccessPolicy.CanResetPartnerUserPassword(access) ||
            access.UserCode == targetUserCode)
        {
            return;
        }

        var detailResult = await ApiClient.GetAsync<ApiResponse<UserManageDetailDto>>(
            $"/api/manage/users/{targetUserCode}");

        if (detailResult == null ||
            !detailResult.Success ||
            detailResult.Data == null)
        {
            return;
        }

        _targetUserCode = targetUserCode;
        _targetUserName = detailResult.Data.UserName;
        _canResetPassword = true;
    }

    private bool TryResolveTargetUserCode(out int userCode)
    {
        userCode = 0;

        var relativePath = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        var segments = relativePath.Split(
            '/',
            StringSplitOptions.RemoveEmptyEntries);

        return segments.Length == 3 &&
               segments[0].Equals("users", StringComparison.OrdinalIgnoreCase) &&
               segments[1].Equals("popup", StringComparison.OrdinalIgnoreCase) &&
               int.TryParse(segments[2], out userCode) &&
               userCode > 0;
    }

    private void OpenModal()
    {
        if (!_canResetPassword || _targetUserCode <= 0)
        {
            return;
        }

        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private void OnCompleted()
    {
        _showModal = false;

        NavigationManager.NavigateTo(
            NavigationManager.Uri,
            forceLoad: true,
            replace: true);
    }
}

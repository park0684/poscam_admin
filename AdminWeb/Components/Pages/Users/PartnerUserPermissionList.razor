@page "/users/permissions"
@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Account
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.UserManage
@using poscam.AdminWeb.Services

@inject ApiClient ApiClient
@inject CurrentUserAccessService CurrentUserAccessService
@inject NavigationManager NavigationManager

<PageTitle>담당자 권한 관리</PageTitle>

<div class="container-fluid mt-4">
    <div class="mb-3">
        <h3 class="mb-0">담당자 권한 관리</h3>
        <small class="text-muted">
            파트너사 담당자별로 관리자 웹에서 사용할 기능을 지정합니다.
        </small>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @MessageCss">
            @_message
        </div>
    }

    @if (_isLoading)
    {
        <div class="alert alert-info">
            담당자 권한 정보를 불러오는 중입니다.
        </div>
    }
    else if (!_canManage)
    {
        <div class="alert alert-warning">
            담당자 권한을 관리할 권한이 없습니다.
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>담당자 목록</strong>
                        <small class="text-muted">총 @FilteredUsers.Count()</small>
                    </div>

                    <div class="card-body border-bottom">
                        <input class="form-control"
                               @bind="_searchText"
                               @bind:event="oninput"
                               placeholder="담당자명, 아이디, 파트너사 검색" />
                    </div>

                    <div class="table-responsive permission-user-list">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>담당자</th>
                                    <th>파트너사</th>
                                    <th>상태</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr class="@GetUserRowClass(user.UserCode)"
                                        role="button"
                                        @onclick="() => SelectUserAsync(user)">
                                        <td>
                                            <div>@user.UserName</div>
                                            <small class="text-muted">@user.UserId</small>
                                        </td>
                                        <td>@(user.PartnerName ?? "-")</td>
                                        <td>
                                            <span class="@GetUserStatusBadge(user.UserStatus)">
                                                @GetUserStatusName(user.UserStatus)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>권한 설정</strong>

                        @if (_selectedUser != null)
                        {
                            <span class="text-muted small">
                                @_selectedUser.UserName · @(_selectedUser.PartnerName ?? "-")
                            </span>
                        }
                    </div>

                    <div class="card-body">
                        @if (_selectedUser == null)
                        {
                            <div class="alert alert-secondary mb-0">
                                권한을 설정할 담당자를 선택하세요.
                            </div>
                        }
                        else if (_isPermissionLoading)
                        {
                            <div class="alert alert-info mb-0">
                                담당자 권한을 불러오는 중입니다.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-end gap-2 mb-3">
                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@_isSaving"
                                        @onclick="SelectAllPermissions">
                                    전체 선택
                                </button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@_isSaving"
                                        @onclick="ClearPermissions">
                                    전체 해제
                                </button>
                            </div>

                            <div class="row g-3">
                                @foreach (var permission in PermissionOptions)
                                {
                                    <div class="col-md-6">
                                        <label class="permission-option">
                                            <input class="form-check-input mt-1"
                                                   type="checkbox"
                                                   checked="@_selectedPermissionCodes.Contains(permission.Code)"
                                                   disabled="@_isSaving"
                                                   @onchange="args => TogglePermission(permission.Code, args)" />
                                            <span>
                                                <strong>@permission.Name</strong>
                                                <small class="d-block text-muted">
                                                    @permission.Description
                                                </small>
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    선택된 권한 @_selectedPermissionCodes.Count개
                                </small>

                                <button class="btn btn-primary"
                                        disabled="@_isSaving"
                                        @onclick="SavePermissionsAsync">
                                    @(_isSaving ? "저장 중..." : "권한 저장")
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .permission-user-list {
        max-height: 600px;
        overflow-y: auto;
    }

    .permission-user-selected {
        --bs-table-bg: rgba(13, 110, 253, 0.10);
    }

    .permission-option {
        display: flex;
        gap: 0.75rem;
        min-height: 92px;
        padding: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        cursor: pointer;
    }

    .permission-option:hover {
        background-color: #f8f9fa;
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isPermissionLoading;
    private bool _isSaving;
    private bool _canManage;
    private bool _isSuccessMessage;

    private string? _message;
    private string? _searchText;

    private List<UserManageListItemDto> _users = new();
    private UserManageListItemDto? _selectedUser;
    private HashSet<int> _selectedPermissionCodes = new();

    private static readonly IReadOnlyList<PermissionOption> PermissionOptions =
        new List<PermissionOption>
        {
            new(5, "담당자 관리", "동일 파트너사의 담당자 조회 및 등록"),
            new(7, "매장 관리", "본인 파트너사의 매장 등록 및 수정"),
            new(9, "담당자 비밀번호 초기화", "동일 파트너사 담당자의 비밀번호 초기화"),
            new(10, "계약 관리", "본인 파트너사의 계약 등록 및 수정"),
            new(11, "라이선스 관리", "라이선스 발급, 폐기 및 복구"),
            new(13, "장비 관리", "PC캠 및 캠뷰어 장비 초기화")
        };

    private IEnumerable<UserManageListItemDto> FilteredUsers
    {
        get
        {
            var users = _users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var keyword = _searchText.Trim();

                users = users.Where(user =>
                    Contains(user.UserName, keyword) ||
                    Contains(user.UserId, keyword) ||
                    Contains(user.PartnerName, keyword));
            }

            return users;
        }
    }

    private string MessageCss =>
        _isSuccessMessage ? "alert-success" : "alert-warning";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var accessResult = await CurrentUserAccessService.GetCurrentAccessAsync();

        if (accessResult.Status == CurrentUserAccessStatus.Unauthenticated)
        {
            CurrentUserAccessService.Invalidate();
            NavigationManager.NavigateTo("/login", forceLoad: true, replace: true);
            return;
        }

        if (!accessResult.Success)
        {
            SetWarning(accessResult.Message);
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _canManage = CurrentUserAccessPolicy.CanManagePartnerUserPermissions(
            accessResult.Data);

        if (_canManage)
        {
            await LoadUsersAsync();
        }

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<
                ApiResponse<List<UserManageListItemDto>>>(
                "/api/manage/users");

            if (result == null)
            {
                SetWarning("담당자 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _users = (result.Data ?? new List<UserManageListItemDto>())
                .OrderBy(user => user.PartnerName)
                .ThenBy(user => user.UserName)
                .ThenBy(user => user.UserCode)
                .ToList();
        }
        catch (Exception exception)
        {
            SetWarning($"담당자 목록 조회 중 오류가 발생했습니다. {exception.Message}");
        }
    }

    private async Task SelectUserAsync(UserManageListItemDto user)
    {
        _selectedUser = user;
        _selectedPermissionCodes.Clear();
        _isPermissionLoading = true;
        _message = null;

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<int>>>(
                $"/api/manage/users/{user.UserCode}/permissions");

            if (result == null)
            {
                SetWarning("담당자 권한 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _selectedPermissionCodes = (result.Data ?? new List<int>())
                .Where(code => PermissionOptions.Any(option => option.Code == code))
                .ToHashSet();
        }
        catch (Exception exception)
        {
            SetWarning($"담당자 권한 조회 중 오류가 발생했습니다. {exception.Message}");
        }
        finally
        {
            _isPermissionLoading = false;
        }
    }

    private async Task SavePermissionsAsync()
    {
        if (_selectedUser == null)
        {
            SetWarning("권한을 저장할 담당자를 선택하세요.");
            return;
        }

        _isSaving = true;
        _message = null;

        try
        {
            var request = new PartnerUserPermissionUpdateRequest
            {
                UserCode = _selectedUser.UserCode,
                PermissionCodes = _selectedPermissionCodes
                    .OrderBy(code => code)
                    .ToList()
            };

            var result = await ApiClient.PutAsync<
                PartnerUserPermissionUpdateRequest,
                ApiResponse<bool>>(
                $"/api/manage/users/{_selectedUser.UserCode}/permissions",
                request);

            if (result == null)
            {
                SetWarning("담당자 권한 저장 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess(result.Message);
        }
        catch (Exception exception)
        {
            SetWarning($"담당자 권한 저장 중 오류가 발생했습니다. {exception.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void TogglePermission(int permissionCode, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;

        if (isChecked)
        {
            _selectedPermissionCodes.Add(permissionCode);
        }
        else
        {
            _selectedPermissionCodes.Remove(permissionCode);
        }
    }

    private void SelectAllPermissions()
    {
        _selectedPermissionCodes = PermissionOptions
            .Select(permission => permission.Code)
            .ToHashSet();
    }

    private void ClearPermissions()
    {
        _selectedPermissionCodes.Clear();
    }

    private string GetUserRowClass(int userCode)
    {
        return _selectedUser?.UserCode == userCode
            ? "permission-user-selected"
            : "";
    }

    private static bool Contains(string? source, string keyword)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetUserStatusName(int status)
    {
        return status switch
        {
            0 => "승인대기",
            1 => "정상",
            2 => "일시중지",
            3 => "무효",
            9 => "차단",
            _ => "알 수 없음"
        };
    }

    private static string GetUserStatusBadge(int status)
    {
        return status switch
        {
            0 => "badge bg-warning text-dark",
            1 => "badge bg-success",
            2 => "badge bg-secondary",
            3 => "badge bg-dark",
            9 => "badge bg-danger",
            _ => "badge bg-light text-dark"
        };
    }

    private void SetSuccess(string? message)
    {
        _isSuccessMessage = true;
        _message = string.IsNullOrWhiteSpace(message)
            ? "담당자 권한이 저장되었습니다."
            : message;
    }

    private void SetWarning(string? message)
    {
        _isSuccessMessage = false;
        _message = string.IsNullOrWhiteSpace(message)
            ? "요청을 처리하지 못했습니다."
            : message;
    }

    private sealed record PermissionOption(
        int Code,
        string Name,
        string Description);
}

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.UserManage
@using poscam.AdminWeb.Services

@inject ApiClient ApiClient

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>담당자 권한 설정</strong>
            @if (!string.IsNullOrWhiteSpace(UserName))
            {
                <span class="text-muted small ms-2">@UserName</span>
            }
        </div>

        @if (!_isLoading)
        {
            <small class="text-muted">
                선택된 권한 @(_selectedPermissionCodes.Count)개
            </small>
        }
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        @if (_isLoading)
        {
            <div class="alert alert-info mb-0">
                담당자 권한을 불러오는 중입니다.
            </div>
        }
        else
        {
            <div class="d-flex justify-content-end gap-2 mb-3">
                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@_isSaving"
                        @onclick="SelectAllPermissions">
                    전체 선택
                </button>

                <button class="btn btn-sm btn-outline-secondary"
                        disabled="@_isSaving"
                        @onclick="ClearPermissions">
                    전체 해제
                </button>
            </div>

            <div class="row g-3">
                @foreach (var permission in PermissionOptions)
                {
                    <div class="col-md-6">
                        <label class="permission-option">
                            <input class="form-check-input mt-1"
                                   type="checkbox"
                                   checked="@_selectedPermissionCodes.Contains(permission.Code)"
                                   disabled="@_isSaving"
                                   @onchange="args => TogglePermission(permission.Code, args)" />

                            <span>
                                <strong>@permission.Name</strong>
                                <small class="d-block text-muted">
                                    @permission.Description
                                </small>
                            </span>
                        </label>
                    </div>
                }
            </div>

            <hr />

            <div class="d-flex justify-content-end">
                <button class="btn btn-primary"
                        disabled="@_isSaving"
                        @onclick="SavePermissionsAsync">
                    @(_isSaving ? "저장 중..." : "권한 저장")
                </button>
            </div>
        }
    </div>
</div>

<style>
    .permission-option {
        display: flex;
        gap: 0.75rem;
        min-height: 92px;
        padding: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        cursor: pointer;
    }

    .permission-option:hover {
        background-color: #f8f9fa;
    }
</style>

@code {
    [Parameter]
    public int UserCode { get; set; }

    [Parameter]
    public string? UserName { get; set; }

    private int _loadedUserCode;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSuccessMessage;
    private string? _message;
    private HashSet<int> _selectedPermissionCodes = new();

    private static readonly IReadOnlyList<PermissionOption> PermissionOptions =
        new List<PermissionOption>
        {
            new(5, "담당자 관리", "동일 파트너사의 담당자 조회 및 등록"),
            new(7, "매장 관리", "본인 파트너사의 매장 등록 및 수정"),
            new(10, "계약 관리", "본인 파트너사의 계약 등록 및 수정"),
            new(11, "라이선스 관리", "라이선스 발급, 폐기 및 복구"),
            new(13, "장비 관리", "PC캠 및 캠뷰어 장비 초기화")
        };

    private string MessageCss =>
        _isSuccessMessage ? "alert-success" : "alert-warning";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedUserCode == UserCode)
        {
            return;
        }

        _loadedUserCode = UserCode;
        await LoadPermissionsAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        _isLoading = true;
        _message = null;
        _selectedPermissionCodes.Clear();

        if (UserCode <= 0)
        {
            SetWarning("담당자 코드가 올바르지 않습니다.");
            _isLoading = false;
            return;
        }

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<int>>>(
                $"/api/manage/users/{UserCode}/permissions");

            if (result == null)
            {
                SetWarning("담당자 권한 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _selectedPermissionCodes = (result.Data ?? new List<int>())
                .Where(code => PermissionOptions.Any(option => option.Code == code))
                .ToHashSet();
        }
        catch (Exception exception)
        {
            SetWarning($"담당자 권한 조회 중 오류가 발생했습니다. {exception.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SavePermissionsAsync()
    {
        if (UserCode <= 0)
        {
            SetWarning("담당자 코드가 올바르지 않습니다.");
            return;
        }

        _isSaving = true;
        _message = null;

        try
        {
            var request = new PartnerUserPermissionUpdateRequest
            {
                UserCode = UserCode,
                PermissionCodes = _selectedPermissionCodes
                    .OrderBy(code => code)
                    .ToList()
            };

            var result = await ApiClient.PutAsync<
                PartnerUserPermissionUpdateRequest,
                ApiResponse<bool>>(
                $"/api/manage/users/{UserCode}/permissions",
                request);

            if (result == null)
            {
                SetWarning("담당자 권한 저장 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess(result.Message);
        }
        catch (Exception exception)
        {
            SetWarning($"담당자 권한 저장 중 오류가 발생했습니다. {exception.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void TogglePermission(int permissionCode, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;

        if (isChecked)
        {
            _selectedPermissionCodes.Add(permissionCode);
        }
        else
        {
            _selectedPermissionCodes.Remove(permissionCode);
        }
    }

    private void SelectAllPermissions()
    {
        _selectedPermissionCodes = PermissionOptions
            .Select(permission => permission.Code)
            .ToHashSet();
    }

    private void ClearPermissions()
    {
        _selectedPermissionCodes.Clear();
    }

    private void SetSuccess(string? message)
    {
        _isSuccessMessage = true;
        _message = string.IsNullOrWhiteSpace(message)
            ? "담당자 권한이 저장되었습니다."
            : message;
    }

    private void SetWarning(string? message)
    {
        _isSuccessMessage = false;
        _message = string.IsNullOrWhiteSpace(message)
            ? "요청을 처리하지 못했습니다."
            : message;
    }

    private sealed record PermissionOption(
        int Code,
        string Name,
        string Description);
}

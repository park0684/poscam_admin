@page "/settlements/price-policies"
@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@using poscam.AdminWeb.Models.Settlement
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>파트너사 단가관리</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">파트너사 단가관리</h3>
            <small class="text-muted">
                파트너사별 PC캠/캠뷰어 월 단가와 적용 기간을 관리합니다.
            </small>
        </div>

        <button class="btn btn-outline-secondary" @onclick="GoDashboard">
            대시보드
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @MessageCss">
            @_message
        </div>
    }

    <div class="row">
        <div class="col-lg-5">
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@(_form.PppCode <= 0 ? "단가 정책 등록" : "단가 정책 수정")</strong>

                    @if (_form.PppCode > 0)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                            신규 등록
                        </button>
                    }
                </div>

                <div class="card-body">
                    @if (!_isAdmin)
                    {
                        <div class="alert alert-secondary">
                            담당자는 단가 정책을 조회할 수만 있습니다. 단가 등록과 수정은 관리자만 가능합니다.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">파트너사 <span class="text-danger">*</span></label>

                        @if (_isAdmin)
                        {
                            <select class="form-select" @bind="_form.PartnerCode" disabled="@_isSaving">
                                <option value="0">파트너사를 선택하세요</option>
                                @foreach (var partner in _partners)
                                {
                                    <option value="@partner.PartnerCode">
                                        @partner.PartnerName
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="form-control" value="본인 소속 파트너사" readonly />
                        }
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">PC캠 월 단가 <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" @bind="_form.PccamPrice" readonly="@(!_isAdmin)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">캠뷰어 월 단가 <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" @bind="_form.ViewerPrice" readonly="@(!_isAdmin)" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">적용 시작월 <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" placeholder="예: 202605" @bind="_form.StartMonth" readonly="@(!_isAdmin)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">적용 종료월</label>
                            <input class="form-control" type="number" placeholder="없으면 비움" @bind="_endMonthText" readonly="@(!_isAdmin)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">상태</label>
                        <select class="form-select" @bind="_form.Status" disabled="@(!_isAdmin || _isSaving)">
                            <option value="1">사용</option>
                            <option value="0">미사용</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">메모</label>
                        <textarea class="form-control" rows="3" @bind="_form.Memo" readonly="@(!_isAdmin)"></textarea>
                    </div>

                    @if (_isAdmin)
                    {
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@_isSaving">
                                초기화
                            </button>
                            <button class="btn btn-primary" @onclick="SavePolicyAsync" disabled="@_isSaving">
                                @(_isSaving ? "저장 중..." : "저장")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <div class="card-header">
                    <strong>검색 조건</strong>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">파트너사</label>
                            @if (_isAdmin)
                            {
                                <select class="form-select" @bind="_selectedPartnerCode">
                                    <option value="0">전체 파트너사</option>
                                    @foreach (var partner in _partners)
                                    {
                                        <option value="@partner.PartnerCode">
                                            @partner.PartnerName
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="form-control" value="본인 소속 파트너사" readonly />
                            }
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100" @onclick="LoadPoliciesAsync">
                                조회
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="alert alert-info">
                    단가 정책을 불러오는 중입니다.
                </div>
            }
            else if (_policies.Count == 0)
            {
                <div class="alert alert-secondary">
                    등록된 단가 정책이 없습니다.
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>단가 정책 목록</strong>
                        <small class="text-muted">총 @_policies.Count</small>
                    </div>

                    <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>파트너사</th>
                                    <th class="text-end">PC캠 단가</th>
                                    <th class="text-end">캠뷰어 단가</th>
                                    <th>적용 시작</th>
                                    <th>적용 종료</th>
                                    <th>상태</th>
                                    <th>메모</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _policies)
                                {
                                    <tr>
                                        <td>@(item.PartnerName ?? $"파트너코드 {item.PartnerCode}")</td>
                                        <td class="text-end">@FormatMoney(item.PppPccamPrice)</td>
                                        <td class="text-end">@FormatMoney(item.PppViewerPrice)</td>
                                        <td>@FormatMonth(item.PppStartMonth)</td>
                                        <td>@(item.PppEndMonth == null ? "-" : FormatMonth(item.PppEndMonth.Value))</td>
                                        <td>
                                            <span class="@GetStatusBadge(item.PppStatus)">
                                                @GetStatusName(item.PppStatus)
                                            </span>
                                        </td>
                                        <td>@(item.PppMemo ?? "-")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditPolicy(item)">
                                                선택
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isAdmin;
    private bool _isSuccessMessage;

    private int _selectedPartnerCode;
    private string? _message;
    private string? _endMonthText;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private PartnerPricePolicySaveRequest _form = new()
    {
        Status = 1
    };

    private List<PartnerListItemDto> _partners = new();
    private List<PartnerPricePolicyDto> _policies = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var role = await AuthStateService.GetUserRoleAsync();
        _isAdmin = role is 0 or 1;

        if (_isAdmin)
        {
            await LoadPartnersAsync();
        }

        ResetForm();
        await LoadPoliciesAsync();

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPartnersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerListItemDto>>>(
                "/api/admin/partners");

            if (result == null)
            {
                SetWarning("파트너사 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _partners = result.Data ?? new List<PartnerListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task LoadPoliciesAsync()
    {
        _message = null;

        try
        {
            var url = "/api/manage/settlements/price-policies";

            if (_isAdmin && _selectedPartnerCode > 0)
            {
                url += $"?partnerCode={_selectedPartnerCode}";
            }

            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerPricePolicyDto>>>(url);

            if (result == null)
            {
                SetWarning("단가 정책 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _policies = result.Data ?? new List<PartnerPricePolicyDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"단가 정책 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task SavePolicyAsync()
    {
        _message = null;

        if (!_isAdmin)
        {
            SetWarning("단가 정책 저장은 관리자만 가능합니다.");
            return;
        }

        if (_form.PartnerCode <= 0)
        {
            SetWarning("파트너사를 선택하세요.");
            return;
        }

        if (_form.PccamPrice < 0 || _form.ViewerPrice < 0)
        {
            SetWarning("단가는 0원 이상이어야 합니다.");
            return;
        }

        if (!TryParseMonth(_form.StartMonth))
        {
            SetWarning("적용 시작월을 올바르게 입력하세요. 예: 202605");
            return;
        }

        if (!string.IsNullOrWhiteSpace(_endMonthText))
        {
            if (!int.TryParse(_endMonthText, out var endMonth) || !TryParseMonth(endMonth))
            {
                SetWarning("적용 종료월을 올바르게 입력하세요. 예: 202605");
                return;
            }

            if (endMonth < _form.StartMonth)
            {
                SetWarning("적용 종료월은 시작월보다 빠를 수 없습니다.");
                return;
            }

            _form.EndMonth = endMonth;
        }
        else
        {
            _form.EndMonth = null;
        }

        _isSaving = true;

        try
        {
            var result = await ApiClient.PostAsync<PartnerPricePolicySaveRequest, ApiResponse<PartnerPricePolicySaveResponse>>(
                "/api/manage/settlements/price-policies",
                _form);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess(result.Message);
            ResetForm();
            await LoadPoliciesAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"단가 정책 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void EditPolicy(PartnerPricePolicyDto item)
    {
        _form = new PartnerPricePolicySaveRequest
        {
            PppCode = item.PppCode,
            PartnerCode = item.PartnerCode,
            PccamPrice = item.PppPccamPrice,
            ViewerPrice = item.PppViewerPrice,
            StartMonth = item.PppStartMonth,
            EndMonth = item.PppEndMonth,
            Status = item.PppStatus,
            Memo = item.PppMemo
        };

        _endMonthText = item.PppEndMonth?.ToString();
        _message = null;
    }

    private void ResetForm()
    {
        _form = new PartnerPricePolicySaveRequest
        {
            PppCode = 0,
            PartnerCode = 0,
            PccamPrice = 0,
            ViewerPrice = 0,
            StartMonth = GetCurrentMonth(),
            EndMonth = null,
            Status = 1,
            Memo = null
        };

        _endMonthText = null;
    }

    private static int GetCurrentMonth()
    {
        var now = DateTime.Now;
        return now.Year * 100 + now.Month;
    }

    private static bool TryParseMonth(int value)
    {
        var year = value / 100;
        var month = value % 100;

        return year is >= 2000 and <= 2099
               && month is >= 1 and <= 12;
    }

    private static string FormatMonth(int value)
    {
        var year = value / 100;
        var month = value % 100;
        return $"{year}-{month:00}";
    }

    private static string FormatMoney(int value)
    {
        return value.ToString("N0") + "원";
    }

    private static string GetStatusName(int status)
    {
        return status switch
        {
            1 => "사용",
            0 => "미사용",
            _ => $"기타({status})"
        };
    }

    private static string GetStatusBadge(int status)
    {
        return status switch
        {
            1 => "badge bg-success",
            0 => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }

    private void GoDashboard()
    {
        NavigationManager.NavigateTo("/");
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }
}

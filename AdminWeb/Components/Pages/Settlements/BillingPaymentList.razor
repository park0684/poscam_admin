@page "/settlements/payments"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@using poscam.AdminWeb.Models.Settlement
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>납부 처리</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">납부 처리</h3>
            <small class="text-muted">
                파트너사별 월 정산 금액의 납부 여부, 납부금액, 납부일을 기록합니다.
            </small>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="GoPartnerMonthly">
                파트너사별 월 정산
            </button>
            <button class="btn btn-outline-secondary" @onclick="GoDashboard">
                대시보드
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @MessageCss">
            @_message
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header">
                    <strong>검색 조건</strong>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">청구월</label>
                            <input class="form-control"
                                   type="number"
                                   placeholder="예: 202605"
                                   @bind="_billMonth" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">파트너사</label>

                            @if (_isAdmin)
                            {
                                <select class="form-select" @bind="_selectedPartnerCode">
                                    <option value="0">전체 파트너사</option>
                                    @foreach (var partner in _partners)
                                    {
                                        <option value="@partner.PartnerCode">
                                            @partner.PartnerName
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="form-control" value="본인 소속 파트너사" readonly />
                            }
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">납부 상태</label>
                            <select class="form-select" @bind="_payStatusText">
                                <option value="">전체</option>
                                <option value="0">미처리</option>
                                <option value="1">미납</option>
                                <option value="2">부분납부</option>
                                <option value="3">납부완료</option>
                                <option value="4">보류</option>
                                <option value="9">취소</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="LoadPaymentsAsync"
                                    disabled="@_isLoading">
                                조회
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="text-muted small">파트너사 수</div>
                            <h4 class="mb-0">@_payments.Count.ToString("N0")개</h4>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="text-muted small">총 청구금액</div>
                            <h4 class="mb-0">@FormatMoney(_payments.Sum(x => x.PayBillAmount))</h4>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="text-muted small">총 납부금액</div>
                            <h4 class="mb-0">@FormatMoney(_payments.Sum(x => x.PayAmount))</h4>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="text-muted small">총 미납금액</div>
                            <h4 class="mb-0">@FormatMoney(_payments.Sum(x => x.PayRemainAmount))</h4>
                        </div>
                    </div>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="alert alert-info">
                    납부 처리 내역을 불러오는 중입니다.
                </div>
            }
            else if (_payments.Count == 0)
            {
                <div class="alert alert-secondary">
                    조회된 납부 처리 내역이 없습니다.
                    먼저 월별 계약 청구자료를 생성해야 합니다.
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>납부 처리 목록</strong>
                        <small class="text-muted">총 @_payments.Count</small>
                    </div>

                    <div class="table-responsive" style="max-height: 620px; overflow-y: auto;">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>파트너사</th>
                                    <th class="text-end">청구금액</th>
                                    <th class="text-end">납부금액</th>
                                    <th class="text-end">미납금액</th>
                                    <th>상태</th>
                                    <th>납부일</th>
                                    <th>방식</th>
                                    <th>메모</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _payments)
                                {
                                    <tr class="@(item.PayCode == _form.PayCode ? "table-primary" : "")">
                                        <td>@(item.PartnerName ?? $"파트너코드 {item.PartnerCode}")</td>
                                        <td class="text-end">@FormatMoney(item.PayBillAmount)</td>
                                        <td class="text-end">@FormatMoney(item.PayAmount)</td>
                                        <td class="text-end">@FormatMoney(item.PayRemainAmount)</td>
                                        <td>
                                            <span class="@GetPaymentStatusBadge(item.PayStatus)">
                                                @GetPaymentStatusName(item.PayStatus)
                                            </span>
                                        </td>
                                        <td>@(item.PayDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td>@(item.PayMethod ?? "-")</td>
                                        <td>@(item.PayMemo ?? "-")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => SelectPayment(item)">
                                                선택
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>납부 처리</strong>

                    @if (_selectedPayment != null)
                    {
                        <span class="@GetPaymentStatusBadge(_selectedPayment.PayStatus)">
                            @GetPaymentStatusName(_selectedPayment.PayStatus)
                        </span>
                    }
                </div>

                <div class="card-body">
                    @if (!_isAdmin)
                    {
                        <div class="alert alert-secondary">
                            담당자는 납부 내역 조회만 가능합니다. 납부 처리는 관리자만 가능합니다.
                        </div>
                    }

                    @if (_selectedPayment == null)
                    {
                        <div class="alert alert-info mb-0">
                            왼쪽 목록에서 납부 처리할 파트너사를 선택하세요.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">파트너사</label>
                            <input class="form-control" value="@(_selectedPayment.PartnerName ?? $"파트너코드 {_selectedPayment.PartnerCode}")" readonly />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">청구월</label>
                                <input class="form-control" value="@FormatMonth(_form.BillMonth)" readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">청구금액</label>
                                <input class="form-control text-end" value="@FormatMoney(_selectedPayment.PayBillAmount)" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">납부금액 <span class="text-danger">*</span></label>
                            <input class="form-control text-end"
                                   type="number"
                                   @bind="_form.PayAmount"
                                   readonly="@(!_isAdmin)" />
                            <small class="text-muted">
                                납부금액 기준으로 미납/부분납부/납부완료 상태가 자동 계산됩니다.
                            </small>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">납부 상태</label>
                                <select class="form-select" @bind="_form.PayStatus" disabled="@(!_isAdmin)">
                                    <option value="0">미처리</option>
                                    <option value="1">미납</option>
                                    <option value="2">부분납부</option>
                                    <option value="3">납부완료</option>
                                    <option value="4">보류</option>
                                    <option value="9">취소</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">납부일</label>
                                <input class="form-control"
                                       type="date"
                                       @bind="_payDateValue"
									   @bind:format="yyyy-MM-dd"
                                       readonly="@(!_isAdmin)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">납부 방식</label>
                            <input class="form-control"
                                   placeholder="예: 계좌이체"
                                   @bind="_form.PayMethod"
                                   readonly="@(!_isAdmin)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">처리 메모</label>
                            <textarea class="form-control"
                                      rows="3"
                                      @bind="_form.Memo"
                                      readonly="@(!_isAdmin)"></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="text-muted small">예상 미납금액</div>
                                <strong>@FormatMoney(GetExpectedRemainAmount())</strong>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted small">예상 상태</div>
                                <span class="@GetPaymentStatusBadge(GetExpectedStatus())">
                                    @GetPaymentStatusName(GetExpectedStatus())
                                </span>
                            </div>
                        </div>

                        @if (_isAdmin)
                        {
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-success"
                                        @onclick="FillFullPayment"
                                        disabled="@_isSaving">
                                    전액 납부 입력
                                </button>
                                <button class="btn btn-outline-warning"
                                        @onclick="ResetToPending"
                                        disabled="@_isSaving">
                                    미처리로 되돌리기
                                </button>
                                <button class="btn btn-primary"
                                        @onclick="SavePaymentAsync"
                                        disabled="@_isSaving">
                                    @(_isSaving ? "저장 중..." : "납부 처리 저장")
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>처리 기준</h6>
                    <p class="text-muted small mb-0">
                        납부 처리는 파트너사 + 청구월 단위로 저장됩니다.
                        저장 후 해당 파트너사의 계약 청구자료 납부 상태도 함께 동기화됩니다.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "billMonth")]
    public int? QueryBillMonth { get; set; }

    [SupplyParameterFromQuery(Name = "partnerCode")]
    public int? QueryPartnerCode { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isAdmin;
    private bool _isSuccessMessage;

    private int _billMonth;
    private int _selectedPartnerCode;
    private string? _payStatusText;
    private DateTime? _payDateValue;
    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private BillingPaymentDto? _selectedPayment;

    private BillingPaymentSaveRequest _form = new();

    private List<PartnerListItemDto> _partners = new();
    private List<BillingPaymentDto> _payments = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _billMonth = QueryBillMonth ?? GetCurrentMonth();
        _selectedPartnerCode = QueryPartnerCode ?? 0;

        var role = await AuthStateService.GetUserRoleAsync();
        _isAdmin = role == 1;

        if (_isAdmin)
        {
            await LoadPartnersAsync();
        }

        await LoadPaymentsAsync();

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPartnersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerListItemDto>>>(
                "/api/admin/partners");

            if (result == null)
            {
                SetWarning("파트너사 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _partners = result.Data ?? new List<PartnerListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task LoadPaymentsAsync()
    {
        _message = null;

        if (!TryParseMonth(_billMonth))
        {
            SetWarning("청구월을 올바르게 입력하세요. 예: 202605");
            return;
        }

        _isLoading = true;

        try
        {
            var url = $"/api/manage/settlements/payments?billMonth={_billMonth}";

            if (_isAdmin && _selectedPartnerCode > 0)
            {
                url += $"&partnerCode={_selectedPartnerCode}";
            }

            if (!string.IsNullOrWhiteSpace(_payStatusText))
            {
                url += $"&payStatus={_payStatusText}";
            }

            var result = await ApiClient.GetAsync<ApiResponse<List<BillingPaymentDto>>>(url);

            if (result == null)
            {
                SetWarning("납부 처리 내역 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _payments = result.Data ?? new List<BillingPaymentDto>();

            if (_selectedPayment != null)
            {
                var refreshed = _payments.FirstOrDefault(x => x.PayCode == _selectedPayment.PayCode);
                if (refreshed != null)
                {
                    SelectPayment(refreshed);
                }
            }
            else if (QueryPartnerCode != null)
            {
                var target = _payments.FirstOrDefault(x => x.PartnerCode == QueryPartnerCode.Value);
                if (target != null)
                {
                    SelectPayment(target);
                }
            }
        }
        catch (Exception ex)
        {
            SetWarning($"납부 처리 내역 조회 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectPayment(BillingPaymentDto item)
    {
        _selectedPayment = item;

        _form = new BillingPaymentSaveRequest
        {
            PayCode = item.PayCode,
            BillMonth = item.BillMonth,
            PartnerCode = item.PartnerCode,
            PayAmount = item.PayAmount,
            PayStatus = item.PayStatus,
            PayDate = item.PayDate,
            PayMethod = item.PayMethod,
            Memo = item.PayMemo
        };

        _payDateValue = item.PayDate;
        _message = null;
    }

    private async Task SavePaymentAsync()
    {
        _message = null;

        if (!_isAdmin)
        {
            SetWarning("납부 처리는 관리자만 가능합니다.");
            return;
        }

        if (_selectedPayment == null)
        {
            SetWarning("납부 처리 대상을 선택하세요.");
            return;
        }

        if (_form.PayAmount < 0)
        {
            SetWarning("납부금액은 0원 이상이어야 합니다.");
            return;
        }

        // DateTime? 값을 그대로 DTO에 넣는다.
        // 문자열 파싱은 필요 없다.
        _form.PayDate = _payDateValue;

        _form.BillMonth = _selectedPayment.BillMonth;
        _form.PartnerCode = _selectedPayment.PartnerCode;

        _isSaving = true;

        try
        {
            var result = await ApiClient.PostAsync<BillingPaymentSaveRequest, ApiResponse<BillingPaymentDto>>(
                "/api/manage/settlements/payments",
                _form);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("납부 처리가 저장되었습니다.");
            _selectedPayment = result.Data;

            await LoadPaymentsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"납부 처리 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void FillFullPayment()
    {
        if (_selectedPayment == null)
        {
            return;
        }

        _form.PayAmount = _selectedPayment.PayBillAmount;
        _form.PayStatus = 3;
        _form.PayDate = DateTime.Today;
        _payDateValue = DateTime.Today;

        if (string.IsNullOrWhiteSpace(_form.PayMethod))
        {
            _form.PayMethod = "계좌이체";
        }
    }

    private int GetExpectedRemainAmount()
    {
        if (_selectedPayment == null)
        {
            return 0;
        }

        return Math.Max(_selectedPayment.PayBillAmount - _form.PayAmount, 0);
    }

    private int GetExpectedStatus()
    {
        if (_form.PayStatus is 4 or 9)
        {
            return _form.PayStatus;
        }

        if (_selectedPayment == null)
        {
            return 0;
        }

        if (_form.PayAmount <= 0)
        {
            return 1;
        }

        if (_form.PayAmount < _selectedPayment.PayBillAmount)
        {
            return 2;
        }

        return 3;
    }

    private static int GetCurrentMonth()
    {
        var now = DateTime.Now;
        return now.Year * 100 + now.Month;
    }

    private static bool TryParseMonth(int value)
    {
        var year = value / 100;
        var month = value % 100;

        return year is >= 2000 and <= 2099
               && month is >= 1 and <= 12;
    }

    private static string FormatMonth(int value)
    {
        var year = value / 100;
        var month = value % 100;
        return $"{year}-{month:00}";
    }

    private static string FormatMoney(int value)
    {
        return value.ToString("N0") + "원";
    }

    private static string GetPaymentStatusName(int status)
    {
        return status switch
        {
            0 => "미처리",
            1 => "미납",
            2 => "부분납부",
            3 => "납부완료",
            4 => "보류",
            9 => "취소",
            _ => $"기타({status})"
        };
    }

    private static string GetPaymentStatusBadge(int status)
    {
        return status switch
        {
            0 => "badge bg-secondary",
            1 => "badge bg-danger",
            2 => "badge bg-warning text-dark",
            3 => "badge bg-success",
            4 => "badge bg-dark",
            9 => "badge bg-danger",
            _ => "badge bg-light text-dark"
        };
    }

    private void GoPartnerMonthly()
    {
        NavigationManager.NavigateTo($"/settlements/partner-monthly");
    }

    private void GoDashboard()
    {
        NavigationManager.NavigateTo("/");
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }

    private void ResetToPending()
    {
        if (_selectedPayment == null)
        {
            return;
        }

        _form.PayAmount = 0;
        _form.PayStatus = 0;
        _form.PayDate = null;
        _form.PayMethod = null;
        _form.Memo = "납부 처리를 미처리 상태로 되돌림";

        _payDateValue = null;
    }
}

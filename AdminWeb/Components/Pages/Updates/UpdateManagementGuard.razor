@using poscam.AdminWeb.Models.Account
@using poscam.AdminWeb.Services
@inject CurrentUserAccessService CurrentUserAccessService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

@if (_state == GuardState.Checking)
{
    <div class="alert alert-secondary mb-3">
        업데이트 관리 권한을 확인하고 있습니다.
    </div>
}
else if (_state == GuardState.Allowed)
{
    @ChildContent
}
else
{
    <div class="alert alert-warning mb-3" role="alert">
        @_message
    </div>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnAuthorized { get; set; }

    private GuardState _state = GuardState.Checking;
    private string _message = "업데이트 관리 권한이 없습니다.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var result = await CurrentUserAccessService.GetCurrentAccessAsync();

        if (result.Status == CurrentUserAccessStatus.Unauthenticated)
        {
            CurrentUserAccessService.Invalidate();
            await AuthStateService.ClearAsync();
            NavigationManager.NavigateTo(
                "/login",
                forceLoad: true,
                replace: true);
            return;
        }

        if (!result.Success
            || !CurrentUserAccessPolicy.CanManageUpdates(result.Data))
        {
            _state = GuardState.Denied;
            _message = result.Status == CurrentUserAccessStatus.Failed
                ? "업데이트 관리 권한을 확인할 수 없습니다. 잠시 후 다시 시도해 주세요."
                : "업데이트 관리 권한이 없습니다.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _state = GuardState.Allowed;
        await InvokeAsync(StateHasChanged);

        if (OnAuthorized.HasDelegate)
        {
            await OnAuthorized.InvokeAsync();
        }
    }

    private enum GuardState
    {
        Checking = 0,
        Allowed = 1,
        Denied = 9
    }
}

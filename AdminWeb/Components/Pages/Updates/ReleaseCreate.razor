@page "/updates/releases/new"
@rendermode InteractiveServer
@using poscam.AdminWeb.Models.Updates
@using poscam.AdminWeb.Services
@inject UpdateApiClient UpdateApiClient
@inject CurrentUserAccessService CurrentUserAccessService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>신규 릴리스</PageTitle>

<UpdateManagementGuard OnAuthorized="LoadProductsAsync">
    @if (_accessDenied)
    {
        <div class="alert alert-warning">업데이트 관리 권한이 없습니다.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-1">신규 릴리스</h3>
                <div class="text-muted">새 Draft 릴리스를 등록합니다.</div>
            </div>
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="BackToList">
                목록
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-danger">@_message</div>
        }

        <div class="card">
            <div class="card-body">
                @if (_isLoading)
                {
                    <div class="text-muted">활성 제품 정보를 불러오는 중입니다.</div>
                }
                else
                {
                    <ReleaseForm Model="_model"
                                 Products="_products"
                                 IsBusy="_isSaving"
                                 SubmitText="Draft 등록"
                                 OnValidSubmit="CreateAsync"
                                 OnCancel="BackToListAsync" />
                }
            </div>
        </div>
    }
</UpdateManagementGuard>

@code {
    private readonly ReleaseEditModel _model = new();
    private readonly List<ActiveProductResponse> _products = new();
    private bool _isLoading;
    private bool _isSaving;
    private bool _accessDenied;
    private string _message = "";

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        _message = "";
        await InvokeAsync(StateHasChanged);

        var result = await UpdateApiClient.GetAsync<List<ActiveProductResponse>>(
            "api/v1/admin/products/active");

        if (result.Success)
        {
            _products.Clear();
            _products.AddRange(result.Data ?? new List<ActiveProductResponse>());

            if (_products.Count > 0)
            {
                _model.ProductCode = _products[0].ProductCode;
            }
        }
        else
        {
            await HandleFailureAsync(result, "활성 제품 목록을 조회하지 못했습니다.");
        }

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        _message = "";
        await InvokeAsync(StateHasChanged);

        var result = await UpdateApiClient.PostAsync<
            CreateReleaseRequest,
            ReleaseDetailResponse>(
            "api/v1/admin/releases",
            _model.ToCreateRequest());

        if (result.Success && result.Data is not null)
        {
            NavigationManager.NavigateTo(
                $"/updates/releases/{result.Data.ReleaseCode}");
            return;
        }

        await HandleFailureAsync(result, "릴리스를 등록하지 못했습니다.");
        _isSaving = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFailureAsync<T>(
        UpdateApiCallResult<T> result,
        string fallback)
    {
        if (result.IsUnauthorized)
        {
            CurrentUserAccessService.Invalidate();
            await AuthStateService.ClearAsync();
            NavigationManager.NavigateTo("/login", forceLoad: true, replace: true);
            return;
        }

        if (result.IsForbidden)
        {
            CurrentUserAccessService.Invalidate();
            _accessDenied = true;
            return;
        }

        _message = result.IsConflict
            ? "동일한 제품·채널·버전의 릴리스가 이미 존재하거나 현재 상태가 변경되었습니다."
            : result.IsServiceUnavailable
                ? "관리자 권한 확인 서비스를 사용할 수 없습니다. 잠시 후 다시 시도해 주세요."
                : string.IsNullOrWhiteSpace(result.Message)
                    ? fallback
                    : result.Message;
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/updates/releases");
    }

    private Task BackToListAsync()
    {
        BackToList();
        return Task.CompletedTask;
    }
}

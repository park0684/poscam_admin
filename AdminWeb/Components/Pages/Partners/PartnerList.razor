@page "/partners"
@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>파트너사 관리</PageTitle>

<div class="container-fluid mt-4">
    <!-- 상단 제목 / 신규 등록 버튼 영역 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">파트너사 관리</h3>
            <small class="text-muted">
                매장 등록, 담당자 배정, 정산 기준이 되는 파트너사를 관리합니다.
            </small>
        </div>

        <!-- 파트너사 등록은 관리자만 가능하다. -->
        @if (_isAdmin)
        {
            <button class="btn btn-primary" @onclick="CreatePartner">
                신규 파트너사 등록
            </button>
        }
    </div>

    <!-- 오류 또는 안내 메시지 표시 -->
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning">
            @_message
        </div>
    }

    <!-- 로딩 중 표시 -->
    @if (_isLoading)
    {
        <div class="alert alert-info">
            파트너사 목록을 불러오는 중입니다.
        </div>
    }
    else if (!_isAdmin)
    {
        <!-- 현재 정책상 파트너사 등록/수정은 관리자만 허용한다. -->
        <div class="alert alert-secondary">
            파트너사 등록/수정 권한이 없습니다.
        </div>
    }
    else if (_partners.Count == 0)
    {
        <div class="alert alert-secondary">
            등록된 파트너사가 없습니다.
        </div>
    }
    else
    {
        <!-- 파트너사 목록 테이블 -->
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>코드</th>
                    <th>파트너사명</th>
                    <th>사업자번호</th>
                    <th>대표자</th>
                    <th>연락처</th>
                    <th>이메일</th>
                    <th>상태</th>
                    <th>등록일</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var partner in _partners)
                {
                    <tr>
                        <td>@partner.PartnerCode</td>
                        <td>@partner.PartnerName</td>
                        <td>@(partner.PartnerBizNum ?? "-")</td>
                        <td>@(partner.PartnerOwnerName ?? "-")</td>
                        <td>@(partner.PartnerTel ?? "-")</td>
                        <td>@(partner.PartnerEmail ?? "-")</td>
                        <td>@GetStatusName(partner.PartnerStatus)</td>
                        <td>@partner.RegisteredAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenPartnerPopupAsync(partner.PartnerCode)">
                                상세
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>
    /// 화면 로딩 상태.
    /// OnAfterRenderAsync에서 최초 1회 API 호출 후 false로 변경한다.
    /// </summary>
    private bool _isLoading = true;

    /// <summary>
    /// 현재 로그인 사용자가 시스템 또는 관리자 계정인지 여부.
    /// UserRole = 0이면 System, 1이면 Admin.
    /// </summary>
    private bool _isAdmin;

    /// <summary>
    /// 화면에 표시할 오류/안내 메시지.
    /// </summary>
    private string? _message;

    /// <summary>
    /// 파트너사 목록 데이터.
    /// GET /api/admin/partners 응답 Data를 저장한다.
    /// </summary>
    private List<PartnerListItemDto> _partners = new();

    /// <summary>
    /// Blazor Server에서 JS/sessionStorage를 사용하는 경우,
    /// 최초 렌더링 이후에 데이터를 읽는 것이 안전하다.
    /// 그래서 OnInitializedAsync 대신 OnAfterRenderAsync에서 처리한다.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var role = await AuthStateService.GetUserRoleAsync();
        // System = 0, Admin = 1
        _isAdmin = role == 0 || role == 1;

        // 정책상 파트너사 목록 관리는 관리자만 사용한다.
        // 담당자에게는 목록을 조회하지 않고 권한 안내만 표시한다.
        if (_isAdmin)
        {
            await LoadPartnersAsync();
        }

        _isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 파트너사 상세 팝업을 연다.
    ///
    /// popup.js의 poscamPopup.openPartnerDetail(partnerCode)를 호출한다.
    /// 실제 팝업 URL은 /partners/popup/{partnerCode} 형식으로 열린다.
    /// </summary>
    private async Task OpenPartnerPopupAsync(int partnerCode)
    {
        if (partnerCode <= 0)
        {
            return;
        }
        await JS.InvokeVoidAsync("poscamPopup.openPartnerDetail", partnerCode);
    }

    /// <summary>
    /// 파트너사 목록 조회.
    /// 백엔드 API: GET /api/admin/partners
    /// </summary>
    private async Task LoadPartnersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerListItemDto>>>(
                "/api/admin/partners");

            if (result == null)
            {
                _message = "서버 응답을 받을 수 없습니다.";
                return;
            }

            if (!result.Success)
            {
                _message = result.Message;

                // 토큰이 없거나 만료된 경우 로그인 화면으로 보낸다.
                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            _partners = result.Data ?? new List<PartnerListItemDto>();
        }
        catch (Exception ex)
        {
            _message = $"파트너사 목록 조회 중 오류가 발생했습니다. {ex.Message}";
        }
    }

    /// <summary>
    /// 신규 파트너사 등록 화면으로 이동한다.
    /// </summary>
    private void CreatePartner()
    {
        NavigationManager.NavigateTo("/partners/new");
    }

    /// <summary>
    /// 파트너사 상세 화면으로 이동한다.
    /// </summary>
    private void OpenDetail(int partnerCode)
    {
        NavigationManager.NavigateTo($"/partners/{partnerCode}");
    }

    /// <summary>
    /// 상태값을 화면용 문자열로 변환한다.
    /// 백엔드는 숫자로 상태를 내려주고, 화면에서는 사람이 읽을 수 있는 이름으로 표시한다.
    /// </summary>
    private string GetStatusName(int status)
    {
        return status switch
        {
            0 => "비활성",
            1 => "정상",
            2 => "일시중지",
            9 => "차단",
            _ => $"기타({status})"
        };
    }
}
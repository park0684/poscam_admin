@page "/partners/popup/{PartnerCode:int}"
@layout poscam.AdminWeb.Components.Layout.PopupLayout
@rendermode InteractiveServer

@using poscam.AdminWeb.Components.Pages.Settlements
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@using poscam.AdminWeb.Models.Settlement
@using poscam.AdminWeb.Models.Account
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject Microsoft.JSInterop.IJSRuntime JS
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService

<PageTitle>파트너사 상세</PageTitle>

<div class="partner-popup">
    <div class="popup-header">
        <div>
            <h5 class="mb-0">파트너사 상세</h5>
            <small class="text-muted">
                PartnerCode: @PartnerCode
            </small>
        </div>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="ClosePopupAsync">
            닫기
        </button>
    </div>

    <div class="popup-body">
        <ul class="nav nav-tabs popup-tab-header">
            <li class="nav-item">
                <button type="button"
                        class="@GetTabClass("basic")"
                        @onclick="@(() => ChangeTabAsync("basic"))">
                    파트너사 기본정보
                </button>
            </li>

            <li class="nav-item">
                <button type="button"
                        class="@GetTabClass("users")"
                        @onclick="@(() => ChangeTabAsync("users"))">
                    직원 리스트
                </button>
            </li>

            <li class="nav-item">
                <button type="button"
                        class="@GetTabClass("price")"
                        @onclick="@(() => ChangeTabAsync("price"))">
                    단가 정책
                </button>
            </li>
        </ul>

        @if (_activeTab == "basic")
        {
            <div class="tab-area">
                @if (_isLoading)
                {
                    <div class="alert alert-info">
                        파트너사 정보를 불러오는 중입니다.
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert @MessageCss">
                            @_message
                        </div>
                    }

                    <div class="card shadow-sm">
                        <div class="card-header">
                            <strong>파트너사 기본정보</strong>
                        </div>

                        <div class="card-body">
                            <div class="row mb-3 g-3">
                                <div class="col-md-6">
                                    <label class="form-label">
                                        파트너사명 <span class="text-danger">*</span>
                                    </label>
                                    <input class="form-control"
                                           @bind="_request.PartnerName"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">사업자번호</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerBizNum"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">대표자명</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerOwnerName"
                                           readonly="@(!_isAdmin)" />
                                </div>
                            </div>

                            <div class="row mb-3 g-3">
                                <div class="col-md-4">
                                    <label class="form-label">연락처</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerTel"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">이메일</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerEmail"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">상태</label>
                                    <select class="form-select"
                                            @bind="_request.PartnerStatus"
                                            disabled="@(!_isAdmin)">
                                        <option value="1">정상</option>
                                        <option value="0">비활성</option>
                                        <option value="2">일시중지</option>
                                        <option value="9">차단</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3 g-3">
                                <div class="col-md-3">
                                    <label class="form-label">우편번호</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerZipcode"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-5">
                                    <label class="form-label">주소</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerAddress1"
                                           readonly="@(!_isAdmin)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">상세주소</label>
                                    <input class="form-control"
                                           @bind="_request.PartnerAddress2"
                                           readonly="@(!_isAdmin)" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">메모</label>
                                <textarea class="form-control"
                                          rows="4"
                                          @bind="_request.PartnerMemo"
                                          readonly="@(!_isAdmin)"></textarea>
                            </div>

                            @if (_isAdmin)
                            {
                                <div class="d-flex justify-content-end">
                                    <button class="btn btn-primary"
                                            @onclick="SavePartnerAsync"
                                            disabled="@_isSaving">
                                        @(_isSaving ? "저장 중..." : "파트너사 정보 저장")
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (_activeTab == "users")
        {
            <div class="tab-area">
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @MessageCss">
                        @_message
                    </div>
                }

                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>직원 리스트</strong>
                        <small class="text-muted">총 @_users.Count.ToString("N0")명</small>
                    </div>

                    <div class="card-body">
                        @if (_isUserLoading)
                        {
                            <div class="alert alert-info mb-0">
                                직원 목록을 불러오는 중입니다.
                            </div>
                        }
                        else if (_users.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">
                                등록된 직원이 없습니다.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                                <table class="table table-sm table-hover table-striped align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>이름</th>
                                            <th>아이디</th>
                                            <th>연락처</th>
											<th>이메일</th>
                                            <th class="text-end">상세</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in _users)
                                        {
                                            <tr>
                                                <td>@user.UserName</td>
                                                <td>@user.UserId</td>
												<td>@user.UserCell</td>
												<td>@user.UserEmail</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpneUserPupupAsync(user.UserCode)">
                                                        상세
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_activeTab == "price")
        {
            <div class="tab-area">
                 <PartnerPricePolicyPanel PartnerCode="@PartnerCode" />
            </div>
        }
    </div>
</div>

<style>
    .partner-popup {
        width: 1420;
        height: 720px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .popup-header {
        height: 64px;
        padding: 12px 18px;
        border-bottom: 1px solid #dee2e6;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .popup-body {
        height: calc(720px - 64px);
        padding: 14px 18px;
        overflow: hidden;
    }

    .popup-tab-header {
        height: 42px;
        margin-bottom: 12px;
    }

    .tab-area {
        height: calc(720px - 64px - 14px - 14px - 42px - 12px);
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 6px;
    }
</style>

@code {
    [Parameter]
    public int PartnerCode { get; set; }

    // 현재 선택된 탭을 저장한다.
    // 기본값은 파트너사 기본정보 탭이다.
    private string _activeTab = "basic";

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isAdmin;
    private bool _isSuccessMessage;

    private string? _message;

    private string MessageCss => _isSuccessMessage
        ? "alert-success"
        : "alert-warning";

    // 파트너사 상세 조회 결과 원본
    private PartnerDetailDto? _partnerDetail;

    // 파트너사 저장 요청용 DTO
    private PartnerUpdateRequest _request = new();

    // 직원 리스트 로딩 여부.
    // 직원 탭을 처음 열었을 때 목록을 조회하는 용도로 사용합니다.
    private bool _isUserLoading;

    // 직원 리스트 조회 완료 여부.
    // 탭을 이동할 때마다 API를 반복 호출하지 않기 위해 사용합니다.
    private bool _usersLoaded;

    // 파트너사에 소속된 직원 목록.
    // 기존 UserListItemDto를 그대로 사용합니다.
    private List<UserListItemDto> _users = new();

    /// <summary>
    /// 현재 선택된 탭에 따라 Bootstrap 탭 CSS 클래스를 반환한다.
    ///
    /// 선택된 탭:
    /// - nav-link active
    ///
    /// 선택되지 않은 탭:
    /// - nav-link
    /// </summary>
    private string GetTabClass(string tab)
    {
        return _activeTab == tab
            ? "nav-link active"
            : "nav-link";
    }


    /// <summary>
    /// 현재 팝업 창을 닫는다.
    ///
    /// window.open으로 열린 팝업에서는 정상적으로 닫힌다.
    /// 사용자가 주소창에 직접 /partners/popup/{PartnerCode}를 입력해서 연 경우에는
    /// 브라우저 정책상 닫히지 않을 수 있다.
    /// </summary>
    private async Task ClosePopupAsync()
    {
        await JS.InvokeVoidAsync("window.close");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 현재 로그인 사용자의 권한을 확인한다.
        // 파트너사 기본정보 수정은 관리자만 가능하게 처리한다.
        var role = await AuthStateService.GetUserRoleAsync();
        _isAdmin = role == 1;

        // URL에 포함된 PartnerCode 기준으로 파트너사 정보를 조회한다.
        await LoadPartnerAsync();

        _isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 파트너사 기본정보를 조회한다.
    ///
    /// 이 메서드는 팝업이 처음 열릴 때 한 번 실행된다.
    /// 조회 결과는 _partnerDetail에 원본으로 보관하고,
    /// 화면에서 수정할 값은 _request에 복사한다.
    ///
    /// 이유:
    /// - 조회 DTO와 저장 DTO를 분리하기 위해서다.
    /// - 사용자가 화면 값을 수정해도 원본 조회 결과를 따로 유지할 수 있다.
    /// </summary>
    private async Task LoadPartnerAsync()
    {
        _message = null;

        if (PartnerCode <= 0)
        {
            SetWarning("파트너사 코드가 올바르지 않습니다.");
            return;
        }

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<PartnerUpdateRequest>>(
            $"/api/admin/partners/{PartnerCode}");

            if (result == null)
            {
                SetWarning("파트너사 정보 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            // 팝업은 URL의 PartnerCode가 기준이다.
            // 혹시 응답 Body의 PartnerCode가 비어 있거나 다르게 오더라도 URL 값을 우선한다.

            _request = new PartnerUpdateRequest
            {
                PartnerCode = result.Data.PartnerCode,
                PartnerName = result.Data.PartnerName,
                PartnerBizNum = result.Data.PartnerBizNum,
                PartnerOwnerName = result.Data.PartnerOwnerName,
                PartnerTel = result.Data.PartnerTel,
                PartnerEmail = result.Data.PartnerEmail,
                PartnerZipcode = result.Data.PartnerZipcode,
                PartnerAddress1 = result.Data.PartnerAddress1,
                PartnerAddress2 = result.Data.PartnerAddress2,
                PartnerMemo = result.Data.PartnerMemo,
                PartnerStatus = result.Data.PartnerStatus
            };
            _request.PartnerCode = PartnerCode;
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 정보 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    /// <summary>
    /// 파트너사 기본정보를 저장한다.
    ///
    /// PartnerCode는 URL 파라미터로 받은 값을 사용한다.
    /// 사용자가 임의로 다른 파트너사를 수정하지 못하도록
    /// 저장 직전에 _request.PartnerCode를 다시 PartnerCode로 고정한다.
    /// </summary>
    private async Task SavePartnerAsync()
    {
        _message = null;
        if (!_isAdmin)
        {
            SetWarning("파트너사 저장은 관리자만 가능합니다.");
            return;
        }
        if (PartnerCode <= 0)
        {
            SetWarning("파트너사 코드가 올바르지 않습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.PartnerName))
        {
            SetWarning("파트너사명을 입력하세요.");
            return;
        }

        _isSaving = true;

        try
        {
            // 팝업은 특정 파트너사 전용 화면이다.
            // 사용자가 다른 파트너사를 수정하지 못하도록 URL의 PartnerCode를 강제로 사용한다.
            _request.PartnerCode = PartnerCode;

            var result = await ApiClient.PutAsync<PartnerUpdateRequest, ApiResponse<PartnerSaveResponse>>(
                $"/api/admin/partners/{PartnerCode}",
                _request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("파트너사 정보가 수정되었습니다.");

            // 저장 후 현재 팝업에서 다시 조회해서 최신 상태를 반영한다.
            await LoadPartnerAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 정보 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// 성공 메시지를 화면에 표시한다.
    /// </summary>
    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    /// <summary>
    /// 경고 또는 오류 메시지를 화면에 표시한다.
    /// </summary>
    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }

    /// <summary>
    /// 탭을 변경합니다.
    ///
    /// 직원 리스트 탭은 처음 열릴 때만 직원 목록을 조회합니다.
    /// 이렇게 하면 팝업 최초 로딩 시 불필요한 API 호출을 줄일 수 있습니다.
    /// </summary>
    private async Task ChangeTabAsync(string tab)
    {
        _activeTab = tab;

        if (tab == "users" && !_usersLoaded)
        {
            await LoadPartnerUsersAsync();
        }
    }

    /// <summary>
    /// 현재 팝업에서 보고 있는 파트너사의 직원 목록을 조회합니다.
    ///
    /// PartnerCode는 URL 파라미터에서 받은 값을 사용합니다.
    /// 따라서 다른 파트너사의 직원을 임의로 조회하지 않습니다.
    ///
    /// 현재는 기존에 사용 중인 active 담당자 조회 API를 사용합니다.
    /// 추후 승인대기/무효 직원까지 모두 표시해야 한다면
    /// API 주소만 전체 직원 조회용으로 교체하면 됩니다.
    /// </summary>
    private async Task LoadPartnerUsersAsync()
    {
        _message = null;

        if (PartnerCode <= 0)
        {
            SetWarning("파트너사 코드가 올바르지 않습니다.");
            return;
        }

        _isUserLoading = true;

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<UserListItemDto>>>(
                $"/api/manage/partners/{PartnerCode}/users/active");

            if (result == null)
            {
                SetWarning("직원 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _users = result.Data ?? new List<UserListItemDto>();
            _usersLoaded = true;
        }
        catch (Exception ex)
        {
            SetWarning($"직원 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isUserLoading = false;
        }
    }

    /// <summary>
    /// 담당자 상세 팝업을 연다.
    ///
    /// - popup.js의 poscamPopup.openUserDetail(userCode)를 호출한다.
    /// - 실제 팝업 URL은 /users/popup/{userCode} 이다.
    /// </summary>
    private async Task OpneUserPupupAsync(int userCode)
    {
        if (userCode <= 0)
        {
            return;
        }
        await JS.InvokeVoidAsync("poscamPopup.openUserDetail", userCode);
    }
}
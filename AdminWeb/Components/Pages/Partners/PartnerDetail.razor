@page "/partners/new"
@page "/partners/{PartnerCode:int}"
@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>파트너사 상세</PageTitle>

<div class="container-fluid mt-4">
    <!-- 상단 제목 / 목록 버튼 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">@PageTitleText</h3>
            <small class="text-muted">
                파트너사 정보는 매장 등록 및 담당자 배정 기준으로 사용됩니다.
            </small>
        </div>

        <button class="btn btn-outline-secondary" @onclick="GoList">
            목록
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="alert alert-info">
            파트너사 정보를 불러오는 중입니다.
        </div>
    }
    else if (!_isAdmin)
    {
        <!-- 등록/수정은 관리자만 가능 -->
        <div class="alert alert-secondary">
            파트너사 등록/수정은 관리자만 가능합니다.
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header">
                <strong>파트너사 기본정보</strong>
            </div>

            <div class="card-body">
                @if (!IsNew)
                {
                    <!-- 기존 파트너사 수정 화면에서만 파트너 코드와 상태를 표시한다. -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">파트너 코드</label>
                            <input class="form-control" value="@_request.PartnerCode" readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">상태</label>
                            <select class="form-select" @bind="_request.PartnerStatus">
                                <option value="1">정상</option>
                                <option value="0">비활성</option>
                                <option value="2">일시중지</option>
                                <option value="9">차단</option>
                            </select>
                        </div>
                    </div>
                }

                <!-- 파트너사명 / 사업자번호 -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            파트너사명 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" @bind="_request.PartnerName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">사업자번호</label>
                        <input class="form-control" @bind="_request.PartnerBizNum" />
                    </div>
                </div>

                <!-- 대표자 / 연락처 / 이메일 -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">대표자명</label>
                        <input class="form-control" @bind="_request.PartnerOwnerName" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">연락처</label>
                        <input class="form-control" @bind="_request.PartnerTel" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">이메일</label>
                        <input class="form-control" @bind="_request.PartnerEmail" />
                    </div>
                </div>

                <!-- 주소 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">우편번호</label>
                        <input class="form-control" @bind="_request.PartnerZipcode" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">주소</label>
                        <input class="form-control" @bind="_request.PartnerAddress1" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">상세주소</label>
                        <input class="form-control" @bind="_request.PartnerAddress2" />
                    </div>
                </div>

                <!-- 메모 -->
                <div class="mb-3">
                    <label class="form-label">메모</label>
                    <textarea class="form-control"
                              rows="4"
                              @bind="_request.PartnerMemo"></textarea>
                </div>

                <!-- 저장 버튼 -->
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary"
                            @onclick="SavePartnerAsync"
                            disabled="@_isSaving">
                        @(_isSaving ? "저장 중..." : "파트너사 저장")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// URL의 partnerCode 파라미터.
    /// /partners/new 에서는 0이므로 신규 등록으로 판단한다.
    /// /partners/{partnerCode} 에서는 해당 코드의 상세를 조회한다.
    /// </summary>
    [Parameter]
    public int PartnerCode { get; set; }

    /// <summary>
    /// 신규 등록 여부.
    /// PartnerCode가 0 이하이면 신규 등록 화면이다.
    /// </summary>
    private bool IsNew => PartnerCode <= 0;

    /// <summary>
    /// 화면 제목.
    /// 신규/수정에 따라 문구를 다르게 표시한다.
    /// </summary>
    private string PageTitleText => IsNew ? "신규 파트너사 등록" : "파트너사 상세";

    private bool _isLoading = true;

    private bool _isSaving;

    /// <summary>
    /// 현재 로그인 사용자가 관리자인지 여부.
    /// 파트너사 등록/수정은 관리자만 가능하다.
    /// </summary>
    private bool _isAdmin;

    /// <summary>
    /// 성공 메시지인지 여부.
    /// true면 alert-success, false면 alert-warning으로 표시한다.
    /// </summary>
    private bool _isSuccessMessage;

    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    /// <summary>
    /// 화면 입력값을 보관하는 객체.
    /// 신규 등록과 수정 모두 이 객체를 사용한다.
    /// 신규 저장 시에는 PartnerCreateRequest로 변환해서 전송한다.
    /// 수정 저장 시에는 PartnerUpdateRequest 그대로 전송한다.
    /// </summary>
    private PartnerUpdateRequest _request = new();

    /// <summary>
    /// 최초 렌더링 이후 로그인 권한 확인과 상세 조회를 수행한다.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var role = await AuthStateService.GetUserRoleAsync();
        _isAdmin = role == 1;

        // 관리자가 아니면 상세 조회나 입력폼 표시 없이 권한 안내만 보여준다.
        if (!_isAdmin)
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (IsNew)
        {
            // 신규 등록 기본값.
            // 신규 등록 시 상태는 기본적으로 정상으로 둔다.
            _request = new PartnerUpdateRequest
            {
                PartnerStatus = 1
            };

            _isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // 기존 파트너사 상세 조회
        await LoadDetailAsync();

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 파트너사 상세 조회.
    /// 백엔드 API: GET /api/admin/partners/{partnerCode}
    /// </summary>
    private async Task LoadDetailAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<PartnerDetailDto>>(
                $"/api/admin/partners/{PartnerCode}");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);

                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            var partner = result.Data;

            // 조회된 상세 정보를 입력폼 객체에 매핑한다.
            _request = new PartnerUpdateRequest
            {
                PartnerCode = partner.PartnerCode,
                PartnerName = partner.PartnerName,
                PartnerBizNum = partner.PartnerBizNum,
                PartnerOwnerName = partner.PartnerOwnerName,
                PartnerTel = partner.PartnerTel,
                PartnerEmail = partner.PartnerEmail,
                PartnerZipcode = partner.PartnerZipcode,
                PartnerAddress1 = partner.PartnerAddress1,
                PartnerAddress2 = partner.PartnerAddress2,
                PartnerMemo = partner.PartnerMemo,
                PartnerStatus = partner.PartnerStatus
            };
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 상세 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    /// <summary>
    /// 파트너사 저장.
    /// 신규 등록과 기존 수정을 이 메서드에서 분기한다.
    ///
    /// 신규:
    /// - POST /api/admin/partners
    ///
    /// 수정:
    /// - PUT /api/admin/partners/{partnerCode}
    /// </summary>
    private async Task SavePartnerAsync()
    {
        _message = null;

        if (!_isAdmin)
        {
            SetWarning("파트너사 저장은 관리자만 가능합니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.PartnerName))
        {
            SetWarning("파트너사명을 입력하세요.");
            return;
        }

        _isSaving = true;

        try
        {
            ApiResponse<PartnerSaveResponse>? result;

            if (IsNew)
            {
                // 신규 등록 API는 PartnerCode와 PartnerStatus를 받지 않는 구조로 분리한다.
                var createRequest = new PartnerCreateRequest
                {
                    PartnerName = _request.PartnerName,
                    PartnerBizNum = _request.PartnerBizNum,
                    PartnerOwnerName = _request.PartnerOwnerName,
                    PartnerTel = _request.PartnerTel,
                    PartnerEmail = _request.PartnerEmail,
                    PartnerZipcode = _request.PartnerZipcode,
                    PartnerAddress1 = _request.PartnerAddress1,
                    PartnerAddress2 = _request.PartnerAddress2,
                    PartnerMemo = _request.PartnerMemo
                };

                result = await ApiClient.PostAsync<PartnerCreateRequest, ApiResponse<PartnerSaveResponse>>(
                    "/api/admin/partners",
                    createRequest);
            }
            else
            {
                // 수정 시에는 URL의 PartnerCode를 기준으로 수정한다.
                // Body에도 같은 값을 넣어 백엔드 DTO와 맞춘다.
                _request.PartnerCode = PartnerCode;

                result = await ApiClient.PutAsync<PartnerUpdateRequest, ApiResponse<PartnerSaveResponse>>(
                    $"/api/admin/partners/{PartnerCode}",
                    _request);
            }

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess(IsNew
                ? "파트너사가 등록되었습니다."
                : "파트너사 정보가 수정되었습니다.");

            // 신규 등록 후에는 생성된 partnerCode 기준으로 상세 화면으로 이동한다.
            if (IsNew)
            {
                NavigationManager.NavigateTo(
                    $"/partners/{result.Data.PartnerCode}",
                    forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }

    private void GoList()
    {
        NavigationManager.NavigateTo("/partners");
    }
}
@page "/stores/popup/access-denied"
@layout poscam.AdminWeb.Components.Layout.PopupLayout
@rendermode InteractiveServer

@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>매장 접근 제한</PageTitle>

<div class="container-fluid p-4">
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h5 class="mb-3">매장 관리 권한이 없습니다.</h5>
            <p class="text-muted mb-4">
                매장 관리 권한이 없거나 현재 접근정보를 확인할 수 없습니다.
            </p>

            <button class="btn btn-outline-secondary"
                    @onclick="ClosePopupAsync">
                닫기
            </button>
        </div>
    </div>
</div>

@code {
    private async Task ClosePopupAsync()
    {
        await JS.InvokeVoidAsync("window.close");
    }
}

@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Account
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Partner
@using poscam.AdminWeb.Models.Store
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>담당자 / 파트너 연결</strong>

        @if (_canManageAssignment)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleForm">
                @(_showForm ? "닫기" : "담당자 연결")
            </button>
        }
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        @if (_isLoading)
        {
            <div class="alert alert-info">
                담당자 정보를 불러오는 중입니다.
            </div>
        }
        else
        {
            @if (_assignments.Count == 0)
            {
                <div class="alert alert-secondary">
                    연결된 담당자가 없습니다.
                </div>
            }
            else
            {
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>담당자</th>
                            <th>연락처</th>
                            <th>파트너사</th>
                            <th>역할</th>
                            <th>대표</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _assignments)
                        {
                            <tr>
                                <td>@item.UserName</td>
                                <td>@(item.UserCell ?? "-")</td>
                                <td>@(item.PartnerName ?? "-")</td>
                                <td>@GetRoleName(item.AssignmentRole)</td>
                                <td>@(item.IsPrimary ? "Y" : "-")</td>
                                <td>
                                    @if (_canManageAssignment)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ReleaseAssignmentAsync(item.AssignmentCode)">
                                            해제
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_canManageAssignment && _showForm)
            {
                <div class="border rounded p-3 mt-3 bg-light">
                    <h6 class="mb-3">담당자 연결</h6>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">파트너사</label>

                            @if (_isAdmin)
                            {
                                <select class="form-select"
                                        @bind="_selectedPartnerCode"
                                        @bind:after="OnPartnerChangedAfterBind">
                                    <option value="0">파트너사를 선택하세요</option>
                                    @foreach (var partner in _partners)
                                    {
                                        <option value="@partner.PartnerCode">@partner.PartnerName</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="form-control"
                                       value="@GetCurrentPartnerName()"
                                       readonly />
                            }

                            <small class="text-muted">
                                파트너사를 기준으로 담당자 목록이 조회됩니다.
                            </small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">담당자</label>
                            <select class="form-select"
                                    @bind="_request.UserCode"
                                    disabled="@(_selectedPartnerCode <= 0 || _users.Count == 0)">
                                <option value="0">담당자를 선택하세요</option>
                                @foreach (var user in _users)
                                {
                                    <option value="@user.UserCode">
                                        @user.UserName (@user.UserId)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">담당 역할</label>
                            <select class="form-select" @bind="_request.AssignmentRole">
                                <option value="MANAGE">관리</option>
                                <option value="SALES">영업</option>
                                <option value="INSTALL">설치</option>
                                <option value="CONTRACT">계약</option>
                                <option value="SUPPORT">지원</option>
                                <option value="ETC">기타</option>
                            </select>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="isPrimaryAssignment"
                                       @bind="_request.IsPrimary" />
                                <label class="form-check-label" for="isPrimaryAssignment">
                                    대표 담당자로 지정
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary"
                                @onclick="AddAssignmentAsync"
                                disabled="@_isSaving">
                            @(_isSaving ? "저장 중..." : "담당자 연결")
                        </button>
                    </div>
                </div>
            }

            if (ShowAdminRequiredMessage && !_isAdmin)
            {
                <div class="alert alert-warning">
                    관리자 권한이 필요합니다.
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int StoreCode { get; set; }

    [Parameter]
    public string Title { get; set; } = "담당자/파트너 연결";

    [Parameter]
    public bool ShowAdminRequiredMessage { get; set; } = true;

    private bool _isLoading = true;

    private bool _isSaving;

    private bool _isSuccessMessage;

    private bool _isAdmin;

    private bool _isPartnerUser;

    private bool _canManageAssignment;

    private int? _loginPartnerCode;

    private int _selectedPartnerCode;

    private bool _showForm;

    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private StoreAssignmentCreateRequest _request = new();

    private List<StoreAssignmentDto> _assignments = new();

    private List<UserListItemDto> _users = new();

    private List<PartnerListItemDto> _partners = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var userRole = await AuthStateService.GetUserRoleAsync();

        _isAdmin = userRole == 1;
        _isPartnerUser = userRole == 2;
        _canManageAssignment = _isAdmin || _isPartnerUser;

        _loginPartnerCode = await AuthStateService.GetPartnerCodeAsync();

        ResetForm();

        await LoadAssignmentsAsync();

        if (_canManageAssignment)
        {
            await LoadPartnersAsync();

            if (_isPartnerUser && _loginPartnerCode != null)
            {
                _selectedPartnerCode = _loginPartnerCode.Value;
                _request.PartnerCode = _loginPartnerCode.Value;

                await LoadUsersByPartnerAsync(_loginPartnerCode.Value);
            }
        }

        _isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAssignmentsAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<StoreDetailResponse>>(
                $"/api/manage/stores/{StoreCode}/detail");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);

                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            _assignments = result.Data.Assignments ?? new List<StoreAssignmentDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 연결 정보 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }
    private async Task LoadUsersByPartnerAsync(int partnerCode)
    {
        _users.Clear();

        if (partnerCode <= 0)
        {
            return;
        }

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<UserListItemDto>>>(
                $"/api/manage/partners/{partnerCode}/users/active");

            if (result == null)
            {
                SetWarning("담당자 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _users = result.Data ?? new List<UserListItemDto>();

            if (_users.Count == 0)
            {
                SetWarning("선택한 파트너사에 승인된 담당자가 없습니다.");
            }
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }
    private async Task LoadUsersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<UserListItemDto>>>(
                "/api/admin/users/active");

            if (result == null)
            {
                SetWarning("담당자 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _users = result.Data ?? new List<UserListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task LoadPartnersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerListItemDto>>>(
                "/api/admin/partners");

            if (result == null)
            {
                SetWarning("파트너사 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _partners = result.Data ?? new List<PartnerListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task AddAssignmentAsync()
    {
        _message = null;

        if (!_canManageAssignment)
        {
            SetWarning("담당자 연결 권한이 없습니다.");
            return;
        }

        if (_isPartnerUser)
        {
            if (_loginPartnerCode == null)
            {
                SetWarning("담당자 계정에 파트너사가 지정되어 있지 않습니다.");
                return;
            }

            _selectedPartnerCode = _loginPartnerCode.Value;
        }

        if (_selectedPartnerCode <= 0)
        {
            SetWarning("파트너사를 선택하세요.");
            return;
        }

        if (_request.UserCode <= 0)
        {
            SetWarning("담당자를 선택하세요.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.AssignmentRole))
        {
            SetWarning("담당 역할을 선택하세요.");
            return;
        }

        _isSaving = true;

        try
        {
            _request.StoreCode = StoreCode;
            _request.PartnerCode = _selectedPartnerCode;

            var result = await ApiClient.PostAsync<StoreAssignmentCreateRequest, ApiResponse<StoreAssignmentResponse>>(
                $"/api/manage/stores/{StoreCode}/assignments",
                _request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("담당자가 연결되었습니다.");

            ResetForm();
            _showForm = false;

            await LoadAssignmentsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 연결 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ReleaseAssignmentAsync(int assignmentCode)
    {
        _message = null;

        if (!_canManageAssignment)
        {
            SetWarning("담당자 연결 해제 권한이 없습니다.");
            return;
        }

        _isSaving = true;

        try
        {
            var result = await ApiClient.DeleteAsync<ApiResponse<bool>>(
                $"/api/manage/stores/assignments/{assignmentCode}");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess("담당자 연결이 해제되었습니다.");

            await LoadAssignmentsAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 연결 해제 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ToggleForm()
    {
        _message = null;
        _showForm = !_showForm;
    }

    private void ResetForm()
    {
        _request = new StoreAssignmentCreateRequest
        {
            StoreCode = StoreCode,
            UserCode = 0,
            PartnerCode = null,
            AssignmentRole = "MANAGE",
            IsPrimary = _assignments.Count == 0
        };

        if (!_isAdmin && _loginPartnerCode != null)
        {
            _selectedPartnerCode = _loginPartnerCode.Value;
            _request.PartnerCode = _loginPartnerCode.Value;
        }
        else
        {
            _selectedPartnerCode = _request.PartnerCode ?? 0;
        }
    }

    private string GetRoleName(string role)
    {
        return role switch
        {
            "MANAGE" => "관리",
            "SALES" => "영업",
            "INSTALL" => "설치",
            "CONTRACT" => "계약",
            "SUPPORT" => "지원",
            "ETC" => "기타",
            _ => role
        };
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }

    private async Task OnPartnerChangedAfterBind()
    {
        _message = null;

        _request.UserCode = 0;
        _users.Clear();

        if (_selectedPartnerCode <= 0)
        {
            _request.PartnerCode = null;
            return;
        }

        _request.PartnerCode = _selectedPartnerCode;

        await LoadUsersByPartnerAsync(_selectedPartnerCode);
    }

    private string GetCurrentPartnerName()
    {
        if (_selectedPartnerCode <= 0)
        {
            return "파트너사 미지정";
        }

        var partner = _partners.FirstOrDefault(x => x.PartnerCode == _selectedPartnerCode);

        if (partner != null)
        {
            return partner.PartnerName;
        }

        return $"파트너코드 {_selectedPartnerCode}";
    }
}
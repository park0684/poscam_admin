@rendermode InteractiveServer

@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Store
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>@Title</strong>

        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadConfigAsync">
            새로고침
        </button>
    </div>

    <div class="card-body">
        <div class="alert alert-secondary">
            NVR 및 채널 설정은 현장 캠뷰어에서만 수정할 수 있습니다.
            관리자 페이지에서는 서버에 동기화된 설정을 조회만 합니다.
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        @if (_isLoading)
        {
            <div class="alert alert-info">
                NVR 설정 정보를 불러오는 중입니다.
            </div>
        }
        else
        {
            @if (_config == null)
            {
                <div class="text-muted">
                    설정 정보를 조회하지 못했습니다.
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">NVR 설정</h6>
                    <span class="text-muted small">총 @GetNvrList().Count대</span>
                </div>

                @if (GetNvrList().Count == 0)
                {
                    <div class="text-muted mb-3">
                        등록된 NVR 설정이 없습니다.
                    </div>
                }
                else
                {
                    <div class="row g-3 mb-4">
                        @foreach (var nvr in GetNvrList())
                        {
                            <div class="col-12 col-xl-6">
                                <div class="border rounded p-3 h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>NVR @nvr.NvrNo</strong>
                                        <span class="badge text-bg-light">
                                            @GetProviderName(nvr.NvrProvider)
                                        </span>
                                    </div>

                                    <dl class="row mb-0">
                                        <dt class="col-5">제조사</dt>
                                        <dd class="col-7">
                                            @GetProviderName(nvr.NvrProvider)
                                            <span class="text-muted">(@nvr.NvrProvider)</span>
                                        </dd>

                                        <dt class="col-5">NVR ID</dt>
                                        <dd class="col-7">@nvr.NvrId</dd>

                                        <dt class="col-5">비밀번호</dt>
                                        <dd class="col-7">
                                            @(nvr.HasPassword ? "저장됨" : "없음")
                                        </dd>

                                        <dt class="col-5">NVR IP</dt>
                                        <dd class="col-7">@nvr.NvrIp</dd>

                                        <dt class="col-5">제어/API Port</dt>
                                        <dd class="col-7">@nvr.NvrPort</dd>

                                        <dt class="col-5">RTSP Port</dt>
                                        <dd class="col-7">@nvr.NvrRtspPort</dd>

                                        <dt class="col-5">채널 수</dt>
                                        <dd class="col-7">@nvr.NvrChannels</dd>

                                        <dt class="col-5">설정 버전</dt>
                                        <dd class="col-7">@(nvr.NvrVersion ?? "-")</dd>
                                    </dl>
                                </div>
                            </div>
                        }
                    </div>
                }

                <h6 class="mb-2">채널 매핑</h6>

                @if (_config.Channels.Count == 0)
                {
                    <div class="text-muted">
                        등록된 채널 매핑이 없습니다.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>POS 번호</th>
                                <th>NVR 번호</th>
                                <th>NVR 채널 번호</th>
                                <th>화면</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var channel in _config.Channels
                                .OrderBy(x => x.PosNo)
                                .ThenBy(x => x.Screen))
                            {
                                <tr>
                                    <td>@channel.PosNo</td>
                                    <td>@channel.NvrNo</td>
                                    <td>@channel.ChannelNo</td>
                                    <td>@GetScreenName(channel.Screen)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int StoreCode { get; set; }

    [Parameter]
    public string Title { get; set; } = "NVR / 채널 설정";

    private bool _isLoading = true;

    private bool _isSuccessMessage;

    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private ManageConfigResponse? _config;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadConfigAsync();

        _isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadConfigAsync()
    {
        _message = null;

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<ManageConfigResponse>>(
                $"/api/manage/stores/{StoreCode}/config");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);

                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            _config = result.Data;
            SetSuccess("NVR 설정 정보를 조회했습니다.");
        }
        catch (Exception ex)
        {
            SetWarning($"NVR 설정 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    /// <summary>
    /// 신규 Nvrs 목록을 우선 사용하고,
    /// 구버전 AuthServer 응답에서는 단일 NvrConfig를 fallback으로 표시한다.
    /// </summary>
    private List<ManageNvrConfigDto> GetNvrList()
    {
        if (_config == null)
        {
            return new List<ManageNvrConfigDto>();
        }

        if (_config.Nvrs != null && _config.Nvrs.Count > 0)
        {
            return _config.Nvrs
                .Where(x => x != null)
                .OrderBy(x => x.NvrNo)
                .ToList();
        }

        if (_config.NvrConfig != null)
        {
            return new List<ManageNvrConfigDto>
            {
                _config.NvrConfig
            };
        }

        return new List<ManageNvrConfigDto>();
    }

    private static string GetProviderName(int provider)
    {
        return provider switch
        {
            1 => "Dahua",
            2 => "TP-Link VIGI",
            3 => "KT Telecop",
            _ => "미지정"
        };
    }

    private static string GetScreenName(int screen)
    {
        return screen switch
        {
            0 => "좌측",
            1 => "우측",
            _ => screen.ToString()
        };
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }
}

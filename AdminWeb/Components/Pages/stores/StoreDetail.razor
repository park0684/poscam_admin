@page "/stores/new"
@page "/stores/{StoreCode:int}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Rendering
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Store
@using poscam.AdminWeb.Models.Account
@using poscam.AdminWeb.Models.Partner

@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService

<PageTitle>매장 상세</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">@PageTitleText</h3>
            <small class="text-muted">
                매장 기본정보를 저장한 뒤 계약, 라이선스, 장비 정보를 관리할 수 있습니다.
            </small>
        </div>

        <button class="btn btn-outline-secondary" @onclick="GoList">
            목록
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="alert alert-info">
            매장 정보를 불러오는 중입니다.
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        <div class="row">
            <div class="col-lg-7">
                <div class="card shadow-sm mb-3">
                    <div class="card-header">
                        <strong>매장 기본정보</strong>
                    </div>

                    <div class="card-body">
                        @if (!IsNew)
                        {
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">매장코드</label>
                                    <input class="form-control" value="@_request.StoreCode" readonly />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">매장 ID</label>
                                    <input class="form-control" value="@_storeId" readonly />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">상태</label>
                                    <select class="form-select" @bind="_request.StoreStatus">
                                        <option value="1">정상</option>
                                        <option value="0">비활성</option>
                                        <option value="2">일시중지</option>
                                        <option value="9">차단</option>
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">매장명 <span class="text-danger">*</span></label>
                                <input class="form-control" @bind="_request.StoreName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">사업자번호</label>
                                <input class="form-control" @bind="_request.StoreBizNum" />
                            </div>
                        </div>
                        @if (IsNew)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">대표 파트너사</label>

                                    @if (_isAdmin)
                                    {
                                        <select class="form-select"
                                                @bind="_selectedPartnerCode"
                                                @bind:after="OnPrimaryPartnerChangedAfterBind">
                                            <option value="0">파트너사를 선택하세요</option>
                                            @foreach (var partner in _partners)
                                            {
                                                <option value="@partner.PartnerCode">
                                                    @partner.PartnerName
                                                </option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control"
                                               value="@GetSelectedPartnerName()"
                                               readonly />
                                    }

                                    <small class="text-muted">
                                        매장 등록 시 대표 관리 파트너로 연결됩니다.
                                    </small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">대표 관리담당자</label>
                                    <select class="form-select"
                                            @bind="_request.PrimaryManagerUserCode"
                                            disabled="@(_selectedPartnerCode <= 0 || _partnerUsers.Count == 0)">
                                        <option value="">담당자를 선택하세요</option>
                                        @foreach (var user in _partnerUsers)
                                        {
                                            <option value="@user.UserCode">
                                                @user.UserName (@user.UserId)
                                            </option>
                                        }
                                    </select>

                                    <small class="text-muted">
                                        담당자 계정으로 등록 시 미선택하면 본인이 대표 담당자로 지정됩니다.
                                    </small>
                                </div>
                            </div>
                        }
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">대표자명</label>
                                <input class="form-control" @bind="_request.StoreOwnerName" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">연락처</label>
                                <input class="form-control" @bind="_request.StoreTel" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">이메일</label>
                                <input class="form-control" @bind="_request.StoreEmail" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">우편번호</label>
                                <input class="form-control" @bind="_request.StoreZipcode" />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">주소</label>
                                <input class="form-control" @bind="_request.StoreAddress1" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">상세주소</label>
                                <input class="form-control" @bind="_request.StoreAddress2" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">메모</label>
                            <textarea class="form-control" rows="3" @bind="_request.StoreMemo"></textarea>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button class="btn btn-primary"
                                    @onclick="SaveStoreAsync"
                                    disabled="@_isSaving">
                                @(_isSaving ? "저장 중..." : "매장정보 저장")
                            </button>
                        </div>
                    </div>
                </div>

                @if (!IsNew)
                {
                    <ContractPanel StoreCode="StoreCode" />

                    <LicensePanel StoreCode="StoreCode" />
                }
            </div>

            <div class="col-lg-5">
                @if (!IsNew)
                {
                    <AssignmentPanel StoreCode="StoreCode" />

                    <DevicePanel StoreCode="StoreCode" />

                    <NvrConfigPanel StoreCode="StoreCode" />
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5>등록 안내</h5>
                            <p class="text-muted mb-0">
                                매장정보를 저장하면 매장코드와 매장 ID가 자동으로 생성됩니다.
                                이후 계약 등록과 라이선스 발급을 진행할 수 있습니다.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int StoreCode { get; set; }

    private bool IsNew => StoreCode <= 0;

    private string PageTitleText => IsNew ? "신규 매장 등록" : "매장 상세";

    private bool _isLoading = true;

    private bool _isSaving;

    private bool _isSuccessMessage;

    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private string _storeId = "";

    private bool _isAdmin;

    private bool _isPartnerUser;

    private int? _loginPartnerCode;

    private int _selectedPartnerCode;

    private List<PartnerListItemDto> _partners = new();

    private List<UserListItemDto> _partnerUsers = new();

    private StoreSaveRequest _request = new();

    private StoreDetailResponse _detail = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (IsNew)
        {
            var userRole = await AuthStateService.GetUserRoleAsync();

            _isAdmin = userRole == 1;
            _isPartnerUser = userRole == 2;
            _loginPartnerCode = await AuthStateService.GetPartnerCodeAsync();

            _request = new StoreSaveRequest
            {
                StoreStatus = 1
            };

            await LoadPartnersAsync();

            if (_isPartnerUser && _loginPartnerCode != null)
            {
                _selectedPartnerCode = _loginPartnerCode.Value;
                _request.PrimaryPartnerCode = _loginPartnerCode.Value;

                await LoadUsersByPartnerAsync(_loginPartnerCode.Value);
            }

            _isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadDetailAsync();

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }
    private async Task LoadPartnersAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<PartnerListItemDto>>>(
                "/api/admin/partners");

            if (result == null)
            {
                SetWarning("파트너사 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _partners = result.Data ?? new List<PartnerListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"파트너사 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task LoadUsersByPartnerAsync(int partnerCode)
    {
        _partnerUsers.Clear();

        if (partnerCode <= 0)
        {
            return;
        }

        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<List<UserListItemDto>>>(
                $"/api/manage/partners/{partnerCode}/users/active");

            if (result == null)
            {
                SetWarning("담당자 목록 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _partnerUsers = result.Data ?? new List<UserListItemDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"담당자 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task OnPrimaryPartnerChangedAfterBind()
    {
        _message = null;

        _request.PrimaryManagerUserCode = null;
        _partnerUsers.Clear();

        if (_selectedPartnerCode <= 0)
        {
            _request.PrimaryPartnerCode = null;
            return;
        }

        _request.PrimaryPartnerCode = _selectedPartnerCode;

        await LoadUsersByPartnerAsync(_selectedPartnerCode);
    }


    private async Task LoadDetailAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<StoreDetailResponse>>(
                $"/api/manage/stores/{StoreCode}/detail");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);

                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            _detail = result.Data;

            _storeId = _detail.Store.StoreId;

            _request = new StoreSaveRequest
            {
                StoreCode = _detail.Store.StoreCode,
                StoreName = _detail.Store.StoreName,
                StoreBizNum = _detail.Store.StoreBizNum,
                StoreOwnerName = _detail.Store.StoreOwnerName,
                StoreTel = _detail.Store.StoreTel,
                StoreEmail = _detail.Store.StoreEmail,
                StoreZipcode = _detail.Store.StoreZipcode,
                StoreAddress1 = _detail.Store.StoreAddress1,
                StoreAddress2 = _detail.Store.StoreAddress2,
                StoreMemo = _detail.Store.StoreMemo,
                StoreStatus = _detail.Store.StoreStatus
            };
        }
        catch (Exception ex)
        {
            SetWarning($"매장 상세 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task SaveStoreAsync()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_request.StoreName))
        {
            SetWarning("매장명을 입력하세요.");
            return;
        }

        if(IsNew)
    {
            if (_isAdmin)
            {
                if (_selectedPartnerCode > 0)
                {
                    _request.PrimaryPartnerCode = _selectedPartnerCode;
                }
                else
                {
                    _request.PrimaryPartnerCode = null;
                }
            }
            else if (_isPartnerUser)
            {
                _request.PrimaryPartnerCode = _loginPartnerCode;
            }
        }
        _isSaving = true;

        try
        {
            var result = await ApiClient.PostAsync<StoreSaveRequest, ApiResponse<StoreSaveResponse>>(
                "/api/manage/stores/save",
                _request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            var saveResult = result.Data;

            _request.StoreCode = saveResult.StoreCode;
            _storeId = saveResult.StoreId;

            if (saveResult.Created)
            {
                SetSuccess($"매장이 등록되었습니다. 매장 ID: {saveResult.StoreId}, 최초 비밀번호: {saveResult.InitialPassword}");

                NavigationManager.NavigateTo($"/stores/{saveResult.StoreCode}", forceLoad: true);
                return;
            }

            SetSuccess("매장 정보가 수정되었습니다.");
        }
        catch (Exception ex)
        {
            SetWarning($"매장 저장 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

   

    private string GetContractTypeName(int type)
    {
        return type switch
        {
            1 => "테스트형",
            2 => "구매형",
            3 => "구독형",
            _ => $"기타({type})"
        };
    }

    private string GetLicenseStatusName(int status)
    {
        return status switch
        {
            0 => "미사용",
            1 => "사용중",
            2 => "초기화",
            9 => "폐기",
            _ => $"기타({status})"
        };
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }

    private void GoList()
    {
        NavigationManager.NavigateTo("/stores");
    }

    private string GetSelectedPartnerName()
    {
        if (_selectedPartnerCode <= 0)
        {
            return "파트너사 미지정";
        }

        var partner = _partners.FirstOrDefault(x => x.PartnerCode == _selectedPartnerCode);

        if (partner != null)
        {
            return partner.PartnerName;
        }

        return $"파트너코드 {_selectedPartnerCode}";
    }
}
@rendermode InteractiveServer

@using Microsoft.JSInterop
@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.Device
@using poscam.AdminWeb.Models.Store
@inject poscam.AdminWeb.Services.ApiClient ApiClient
@inject poscam.AdminWeb.Services.AuthStateService AuthStateService
@inject poscam.AdminWeb.Services.CurrentUserAccessService CurrentUserAccessService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>연결 디바이스</strong>

        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDevicesAsync">
            새로고침
        </button>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @MessageCss">
                @_message
            </div>
        }

        @if (_isLoading)
        {
            <div class="alert alert-info">
                장비 정보를 불러오는 중입니다.
            </div>
        }
        else
        {
            <div class="mb-4">
                <h6 class="mb-2">PC캠 장비</h6>

                @if (_pccams.Count == 0)
                {
                    <div class="text-muted">
                        등록된 PC캠 장비가 없습니다.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>장비코드</th>
                                <th>라이선스</th>
                                <th>POS</th>
                                <th>장비명</th>
                                <th>HWID</th>
                                <th>등록일</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in _pccams)
                            {
                                <tr>
                                    <td>@device.DeviceCode</td>
                                    <td>@(device.LicenseCode?.ToString() ?? "-")</td>
                                    <td>@device.PosNo</td>
                                    <td>@(device.DeviceName ?? "-")</td>
                                    <td>@device.HwidMasked</td>
                                    <td>@(device.RegisteredAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        @if (_canResetDevices)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ResetDeviceAsync(device, true)"
                                                    disabled="@_isResetting">
                                                초기화
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">권한 없음</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <hr />

            <div>
                <h6 class="mb-2">캠뷰어 장비</h6>

                @if (_viewers.Count == 0)
                {
                    <div class="text-muted">
                        등록된 캠뷰어 장비가 없습니다.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>장비코드</th>
                                <th>POS</th>
                                <th>장비명</th>
                                <th>HWID</th>
                                <th>등록일</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in _viewers)
                            {
                                <tr>
                                    <td>@device.DeviceCode</td>
                                    <td>@device.PosNo</td>
                                    <td>@(device.DeviceName ?? "-")</td>
                                    <td>@device.HwidMasked</td>
                                    <td>@(device.RegisteredAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        @if (_canResetDevices)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ResetDeviceAsync(device, false)"
                                                    disabled="@_isResetting">
                                                초기화
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">권한 없음</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (_canResetDevices)
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    PC캠 초기화 시 연결된 라이선스가 재등록 가능한 상태로 변경됩니다.
                    캠뷰어 초기화 시 해당 장비의 기존 토큰은 더 이상 사용할 수 없습니다.
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int StoreCode { get; set; }

    private const int SystemRole = 0;
    private const int AdminRole = 1;
    private const int PartnerUserRole = 2;
    private const int DeviceManagePermissionCode = 13;

    private bool _isLoading = true;

    private bool _isResetting;

    private bool _canResetDevices;

    private bool _isSuccessMessage;

    private string? _message;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private List<StoreDeviceDto> _pccams = new();

    private List<StoreDeviceDto> _viewers = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadResetPermissionAsync();
        await LoadDevicesAsync();

        _isLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadResetPermissionAsync()
    {
        var userRole = await AuthStateService.GetUserRoleAsync();

        if (userRole is SystemRole or PartnerUserRole)
        {
            _canResetDevices = true;
            return;
        }

        if (userRole != AdminRole)
        {
            _canResetDevices = false;
            return;
        }

        var accessResult = await CurrentUserAccessService.GetCurrentAccessAsync();

        _canResetDevices = accessResult.Success
                           && accessResult.Data != null
                           && accessResult.Data.UserRole == AdminRole
                           && accessResult.Data.PermissionCodes.Contains(
                               DeviceManagePermissionCode);
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            var result = await ApiClient.GetAsync<ApiResponse<StoreDetailResponse>>(
                $"/api/manage/stores/{StoreCode}/detail");

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);

                if (result.Message.Contains("토큰") || result.Message.Contains("로그인"))
                {
                    NavigationManager.NavigateTo("/login");
                }

                return;
            }

            _pccams = result.Data.Devices.Pccams ?? new List<StoreDeviceDto>();
            _viewers = result.Data.Devices.Viewers ?? new List<StoreDeviceDto>();
        }
        catch (Exception ex)
        {
            SetWarning($"장비 목록 조회 중 오류가 발생했습니다. {ex.Message}");
        }
    }

    private async Task ResetDeviceAsync(StoreDeviceDto device, bool isPccam)
    {
        if (!_canResetDevices)
        {
            SetWarning("장비를 초기화할 권한이 없습니다.");
            return;
        }

        _message = null;

        var deviceTypeName = isPccam ? "PC캠" : "캠뷰어";

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"{deviceTypeName} 장비를 초기화하시겠습니까?\n\n장비코드: {device.DeviceCode}\n장비명: {device.DeviceName ?? "-"}");

        if (!confirmed)
        {
            return;
        }

        _isResetting = true;

        try
        {
            var request = new DeviceResetRequest
            {
                DeviceCode = device.DeviceCode,
                Reason = $"{deviceTypeName} 장비 초기화"
            };

            var result = await ApiClient.PostAsync<DeviceResetRequest, ApiResponse<DeviceResetResponse>>(
                "/api/devices/reset",
                request);

            if (result == null)
            {
                SetWarning("서버 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success || result.Data == null)
            {
                SetWarning(result.Message);
                return;
            }

            SetSuccess(result.Message);

            await LoadDevicesAsync();
        }
        catch (Exception ex)
        {
            SetWarning($"장비 초기화 중 오류가 발생했습니다. {ex.Message}");
        }
        finally
        {
            _isResetting = false;
        }
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }
}

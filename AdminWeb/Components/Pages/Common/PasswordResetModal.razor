@using poscam.AdminWeb.Models.Common
@using poscam.AdminWeb.Models.UserManage

@inject poscam.AdminWeb.Services.ApiClient ApiClient

@if (IsOpen)
{
    <div class="modal fade show d-block password-reset-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header py-2">
                    <h5 class="modal-title">@ModalTitle</h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseAsync">
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert @MessageCss py-2 mb-2">
                            @_message
                        </div>
                    }

                    <div class="mb-2">
                        <label class="form-label">대상</label>
                        <input class="form-control"
                               value="@TargetDisplayText"
                               readonly />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">새 비밀번호</label>
                        <input type="password"
                               class="form-control"
                               @bind="_newPassword" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label">처리 메모</label>
                        <textarea class="form-control"
                                  rows="2"
                                  @bind="_memo"></textarea>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button class="btn btn-outline-secondary"
                            @onclick="CloseAsync">
                        닫기
                    </button>

                    <button class="btn btn-danger"
                            disabled="@_isProcessing"
                            @onclick="ResetPasswordAsync">
                        비밀번호 초기화
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<style>
    .password-reset-modal {
        z-index: 1060;
    }

        .password-reset-modal + .modal-backdrop {
            z-index: 1050;
        }

        .password-reset-modal .modal-dialog {
            max-width: 520px;
        }

        .password-reset-modal .modal-body {
            padding: 12px 16px;
        }

        .password-reset-modal .form-label {
            margin-bottom: 4px;
            font-weight: 500;
        }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string TargetType { get; set; } = "";

    [Parameter]
    public int UserCode { get; set; }

    [Parameter]
    public string? TargetName { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnCompleted { get; set; }

    private string _newPassword = "";
    private string? _memo;
    private string? _message;
    private bool _isSuccessMessage;
    private bool _isProcessing;

    private string MessageCss => _isSuccessMessage ? "alert-success" : "alert-warning";

    private string ModalTitle => TargetType.ToLower() switch
    {
        "admin" => "관리자 비밀번호 초기화",
        "user" => "담당자 비밀번호 초기화",
        _ => "비밀번호 초기화"
    };

    private string TargetDisplayText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(TargetName))
            {
                return $"{TargetName} ({UserCode})";
            }

            return UserCode.ToString();
        }
    }

    private async Task ResetPasswordAsync()
    {
        _message = null;

        if (UserCode <= 0)
        {
            SetWarning("초기화 대상 코드가 올바르지 않습니다.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            SetWarning("새 비밀번호를 입력하세요.");
            return;
        }

        _isProcessing = true;

        try
        {
            var request = new UserPasswordChangeRequest
            {
                NewPassword = _newPassword,
                Memo = _memo
            };

            ApiResponse<bool>? result;
            var targetType = TargetType.ToLower();

            if (targetType == "admin")
            {
                result = await ApiClient.PutAsync<UserPasswordChangeRequest, ApiResponse<bool>>(
                    $"/api/admin/accounts/{UserCode}/password",
                    request);
            }
            else if (targetType == "user")
            {
                result = await ApiClient.PostAsync<UserPasswordChangeRequest, ApiResponse<bool>>(
                    $"/api/manage/users/{UserCode}/password-reset",
                    request);
            }
            else
            {
                SetWarning("비밀번호 초기화 대상 유형이 올바르지 않습니다.");
                return;
            }

            if (result == null)
            {
                SetWarning("비밀번호 초기화 응답을 받을 수 없습니다.");
                return;
            }

            if (!result.Success)
            {
                SetWarning(result.Message);
                return;
            }

            _newPassword = "";
            _memo = null;

            SetSuccess(result.Message);

            await OnCompleted.InvokeAsync();
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task CloseAsync()
    {
        _newPassword = "";
        _memo = null;
        _message = null;
        _isSuccessMessage = false;

        await OnClose.InvokeAsync();
    }

    private void SetSuccess(string message)
    {
        _isSuccessMessage = true;
        _message = message;
    }

    private void SetWarning(string message)
    {
        _isSuccessMessage = false;
        _message = message;
    }
}